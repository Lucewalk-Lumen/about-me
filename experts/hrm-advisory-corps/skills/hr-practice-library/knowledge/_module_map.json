      "id_range": "F001–F029",
      "role": "定编制、定岗位、定预算：把组织目标翻译成人力供给与需求的数量、结构与成本口径，是后续所有选育用留动作的依据来源。",
      "upstream": [],
      "downstream": [
        "REC"
      ]
    },
    {
      "code": "REC",
      "zh": "招聘与配置管理",
      "order": 2,
      "id_range": "F030–F056",
      "role": "选人：把规划出的岗位需求转化为甄选、录用、试用与转正的具体动作，产出可追溯的评价记录。",
      "upstream": [
        "HRP"
      ],
      "downstream": [
        "TRN",
        "PER"
      ]
    },
    {
      "code": "TRN",
      "zh": "培训与开发管理",
      "order": 3,
      "id_range": "F057–F079",
      "role": "育人：把岗位能力缺口转化为培训需求、课程与经费安排，并留下可核查的培训与考核记录。",
      "upstream": [
        "REC"
      ],
      "downstream": [
        "PER",
        "ARC"
      ]
    },
    {
      "code": "PER",
      "zh": "绩效管理",
      "order": 4,
      "id_range": "F080–F103",
      "role": "用人评价：把组织目标层层分解为指标与合约，经考核、面谈、申诉与改进形成闭环，输出评价结果。",
      "upstream": [
        "REC",
        "TRN"
      ],
      "downstream": [
        "COM",
        "ARC"
      ]
    },
    {
      "code": "COM",
      "zh": "薪酬福利管理",
      "order": 5,
      "id_range": "F104–F137",
      "role": "留人：把绩效评价与市场水平转化为薪酬、奖金、津贴、社保与日常考勤福利的具体兑现规则。",
      "upstream": [
        "PER"
      ],
      "downstream": [
        "ER",
        "ARC"
      ]
    },
    {
      "code": "ER",
      "zh": "员工关系管理",
      "order": 6,
      "id_range": "F138–F164",
      "role": "护人：以劳动合同、满意度、职业生涯、纪律与离职管理维护雇佣关系的合规与温度，是风险高发域。",
      "upstream": [
        "COM"
      ],
      "downstream": [
        "ARC"
      ]
    },
    {
      "code": "ARC",
      "zh": "人事档案管理",
      "order": 7,
      "id_range": "F165–F199",
      "role": "存证：对前六个模块产生的全部记录做收集、归档、保管、查阅与销毁的合规管理，是闭环的汇聚点与审计依据。",
      "upstream": [
        "REC",
        "TRN",
        "PER",
        "COM",
        "ER"
      ],
      "downstream": []
    }
  ],
