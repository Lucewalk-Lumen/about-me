{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "obhrm://scale-library/schema.json",
  "title": "OBHRM 量表库 Schema",
  "description": "定义量表条目合并存储 knowledge/scales/entities.json 与量表索引 knowledge/_scale_index.json 的结构契约。合并存储为条目唯一来源：entities.json 是以 scale_id 为键的对象，每个键的值是一个符合 entry 子 schema 的量表条目。新增/修改量表条目须同时符合 entry 与 index 两个子 schema。",
  "$defs": {
    "scale_id": {
      "type": "string",
      "pattern": "^S[0-9]{3}$",
      "description": "量表稳定主键，形如 S001。为合并存储 entities.json 中的键名。"
    },
    "construct_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "构念稳定键（变量名归一化 slug），用于与理论库 / R 库跨库串联；跨库构念索引以此为主键。"
    },
    "status": {
      "enum": [
        "verified",
        "draft",
        "deprecated"
      ],
      "description": "条目生命周期状态。verified = 已核验可用于学术产出；draft 资料本身真实、可引用出结果，但输出须显著标记「来源未确证」，严禁编造；deprecated 保留但不再推荐。"
    },
    "bilingual": {
      "type": "object",
      "description": "变量名中英对照。en 必填非空；zh 允许为空字符串——但全库 601 条实测 variable.zh 均为非空，字段留空属数据完整性缺口而非结构违例。",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "zh": {
          "type": "string"
        }
      },
      "required": [
        "en",
        "zh"
      ],
      "additionalProperties": false
    },
    "item_range": {
      "description": "维度覆盖的题项区间 [起, 止]，闭区间。三种合法形态：① 整数对（多数量表按题号编号，允许从 0 起）；② 字符串对（原始量表使用带前缀的题项代码，如 ['CPI1','SI4']、['1a','6b']、['X1','X9']）；③ null（原始文献未给出该维度的题项映射，或该维度的题项编号非连续、无法用闭区间表示）。不得混用整数与字符串。**三种形态的具体条数随语料增删而变动，本文档不固化数字**，需要计数时对合并存储 `knowledge/scales/entities.json` 实测。早期版本此处写死的「2 / 14 / 18 处」已与语料不符，属过期数据。",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "dimension": {
      "type": "object",
      "description": "量表维度。item_count 为 0 且 item_range 为 null 表示原始文献未给出该维度的题项映射（历史数据允许，不视为违例）。",
      "properties": {
        "name_zh": {
          "type": "string"
        },
        "name_en": {
          "type": "string"
        },
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "item_range": {
          "$ref": "#/$defs/item_range"
        },
        "scoring": {
          "type": "string"
        }
      },
      "required": [
        "name_zh",
        "name_en",
        "item_count",
        "item_range",
        "scoring"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "description": "量表题项。no 允许 integer 或 string：历史数据中存在字符串型编号（如 '1a'），故不做纯整数约束。**具体条数随语料变动，不在此固化**。",
      "properties": {
        "no": {
          "type": [
            "integer",
            "string"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "type": "string"
        },
        "reverse": {
          "type": "boolean",
          "description": "是否反向计分题。计分时必须尊重此标记，否则信度与效度结论错误。"
        }
      },
      "required": [
        "no",
        "text",
        "dimension",
        "reverse"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "title": "量表条目记录（合并存储 knowledge/scales/entities.json 中的单条）",
      "properties": {
        "scale_id": {
          "$ref": "#/$defs/scale_id"
        },
        "construct_id": {
          "$ref": "#/$defs/construct_id"
        },
        "variable": {
          "$ref": "#/$defs/bilingual"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "string"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimension"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "reference_used": {
          "type": "string",
          "description": "条目文本的取用文献（作者, 年, 期刊，本库录入所据）。**不是量表的原始出处**——原始出处见 background。出处追溯必需，不得为空；正式引用须核对原始文献，不得直接引用本字段。",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "scale_id",
        "construct_id",
        "variable",
        "title",
        "background",
        "dimensions",
        "items",
        "reference_used",
        "status",
        "note"
      ],
      "additionalProperties": false
    },
    "store": {
      "type": "object",
      "title": "量表合并存储（knowledge/scales/entities.json）",
      "description": "条目唯一来源。以 scale_id 为键的对象，每个值符合 entry 子 schema；键名必须与值内 scale_id 一致。",
      "propertyNames": {
        "pattern": "^S[0-9]{3}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    },
    "index_node": {
      "type": "object",
      "title": "量表索引节点（_scale_index.json.nodes[]）",
      "description": "索引节点是合并存储条目的摘要投影。n_dims / n_items 必须与条目实际长度一致；variable_en / variable_zh 对应条目中 variable.en / variable.zh。",
      "properties": {
        "scale_id": {
          "$ref": "#/$defs/scale_id"
        },
        "construct_id": {
          "$ref": "#/$defs/construct_id"
        },
        "variable_en": {
          "type": "string"
        },
        "variable_zh": {
          "type": "string"
        },
        "n_dims": {
          "type": "integer",
          "minimum": 0
        },
        "n_items": {
          "type": "integer",
          "minimum": 0
        },
        "reference_used": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "has_scoring": {
          "type": "boolean",
          "description": "该量表各维度是否均载明计分方式。true = 所有 dimensions[].scoring 非空；false = 存在未载明的维度（原始资料即缺失，输出层显式标注「原文未覆盖」，不得臆造计分规则）。须与合并存储条目实际状态一致。"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "scale_id",
        "construct_id",
        "variable_en",
        "variable_zh",
        "n_dims",
        "n_items",
        "reference_used",
        "status",
        "note",
        "has_scoring"
      ],
      "additionalProperties": false
    },
    "index": {
      "type": "object",
      "title": "量表索引文件（knowledge/_scale_index.json）",
      "properties": {
        "_meta": {
          "type": "object",
          "properties": {
            "schema": {
              "const": "scale"
            },
            "fields": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "description": "必须等于 nodes 长度且等于合并存储 entities.json 中的条目数。"
            },
            "flags": {
              "type": "string",
              "description": "索引 flag 字段说明（当前：has_scoring）。"
            }
          },
          "required": [
            "schema",
            "count"
          ],
          "additionalProperties": true
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index_node"
          }
        }
      },
      "required": [
        "_meta",
        "nodes"
      ],
      "additionalProperties": false
    }
  }
}
