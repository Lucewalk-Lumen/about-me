Title:

          Hopkins Cohort 1 All time points with Classroom Information

Data:
            File = Cohort1_classroom_ALL.DAT;


Variable:

          Names are PRCID 
          
          stub1F bkRule1F harmO1F bkThin1F yell1F
          takeP1F fight1F lies1F tease1F
          
          stub1S bkRule1S harmO1S bkThin1S yell1S
          takeP1S fight1S lies1S tease1S

          stub2S bkRule2S harmO2S bkThin2S yell2S
          takeP2S fight2S lies2S tease2S


          stub3S bkRule3S harmO3S bkThin3S yell3S
          takeP3S fight3S lies3S tease3S


          stub4S bkRule4S harmO4S bkThin4S yell4S
          takeP4S fight4S lies4S tease4S


          stub5S bkRule5S harmO5S bkThin5S yell5S
          takeP5S fight5S lies5S tease5S

          stub6S bkRule6S harmO6S bkThin6S yell6S
          takeP6S fight6S lies6S tease6S

          stub7S bkRule7S harmO7S bkThin7S yell7S
          takeP7S fight7S lies7S tease7S

          gender race des011 sch011 sec011 juv99 violchld antisocr conductr 

          

         athort1F
         harmP1S athort1S
         harmP2S athort2S
         harmP3S athort3S
         harmP4S athort4S
         harmP5S athort5S
         harmP6S 
         harmP7S athort7S

          stub2F bkRule2F harmO2F bkThin2F yell2F
          takeP2F fight2F harmP2F lies2F athort2F tease2F	
  	      CLASSRM;
            !Variable Name Convention ____1F: first Grade Fall, 
            !                         ___1S: 1st Grade Spring

            !1st Grade Fall 10 items harmO1F 
            !1st Grade Spring 11 items: harmO1F broken into harmO1S and harmP1S 
            !stub1F : Stubborn 1st Grade Fall
            !bkRule1F: Break Rules 1st Grade Fall
            !harmO1F : Harm Others and Property 1st Grade Fall
            !bkThin1F: Break Things 1st Grade Fall
            !yell1F: Yells at Others 1st Grade Fall
            !takeP1F: Take Others' Property 1st Grade Fall
            !fight1F: Fights 1st Grade Fall
            !lies1F: Lies 1st Grade Fall
            !tease1F: Tease Classmates 1st Grade Fall
            !athort1F: Trouble accepting authority 1st Grade Fall
            
            !harmP1S: Harms Property 1st Grade Spring
            !athort1S: Trouble accepting authority 1st Grade Spring

            !scho011: School ID
            !sec011: Classroom ID
            !Gender: 1-Male 2-Female
            !des011: 1-CtrlSchool 2-GBGCtrl 3-Mastery Learning Ctrl
            !        4-GBG   5-Mastery Learning          

          Cluster=classrm;

          Usevar =        

          bkThin1f bkThin1s bkThin2s bkThin3s bkThin4s bkThin5s
          bkThin6s bkThin7s 
          
          harmO1f harmO1s harmO2s harmO3s harmO4s harmO5s
          harmO6s harmO7s 

          takeP1f takeP1s takeP2s takeP3s takeP4s takeP5s
          takeP6s takeP7s 

          male; 
          
!          group1 group2 group3 group4;

          categorical = bkThin1f - takeP7s;

          within = male;

  !        between = group1 group2 group3 group4;
                   
          Missing = all (999);

Define:
         cut stub1f-tease7s (1.5 2.5 3.5);
   
        male = 2 - gender;
        group1 = 0;
        group2 = 0;
        group3 = 0;
        group4 = 0;
        if(des011 eq 2)then group1=1;
        if(des011 eq 3)then group2=1;
        if(des011 eq 4)then group3=1;
        if(des011 eq 5)then group4=1;
        
Analysis: 
   
        type = twolevel;  
		process = 2;
        estimator = bayes;
        fbiter = 100000;
  

model:
		%within%

        f1 by bkthin1f 
        harmo1f (1)
        takeP1f (2);
        f2 by bkthin1s 
        harmo1s (1)
        takeP1s (2);
        f3 by bkthin2s 
        harmo2s (1)
        takeP2s (2);
        f4 by bkthin3s 
        harmo3s (1)
        takeP3s (2);
        f5 by bkthin4s 
        harmo4s (1)
        takeP4s (2);
        f6 by bkthin5s 
        harmo5s (1)
        takeP5s (2);
        f7 by bkthin6s 
        harmo6s (1)
        takeP6s (2);
        f8 by bkthin7s 
        harmo7s (1)
        takeP7s (2);


        iw sw qw | f1@0 f2@.5 f3@1.5 f4@2.5 
        f5@3.5 f6@4.5 f7@5.5 f8@6.5;
 

        iw-qw on male;
       

		%between%

        f1b by bkthin1f 
        harmo1f (1)
        takeP1f (2);
        f2b by bkthin1s 
        harmo1s (1)
        takeP1s (2);
        f3b by bkthin2s 
        harmo2s (1)
        takeP2s (2);
        f4b by bkthin3s 
        harmo3s (1)
        takeP3s (2);
        f5b by bkthin4s 
        harmo4s (1)
        takeP4s (2);
        f6b by bkthin5s 
        harmo5s (1)
        takeP5s (2);
        f7b by bkthin6s 
        harmo6s (1)
        takeP6s (2);
        f8b by bkthin7s 
        harmo7s (1)
        takeP7s (2);

        
        [bkthin1f$1 bkthin1s$1 bkthin2s$1 bkthin3s$1 bkthin4s$1] (11);
        [bkthin5s$1 bkthin6s$1 bkthin7s$1] (11);
        [bkthin1f$2 bkthin1s$2 bkthin2s$2 bkthin3s$2 bkthin4s$2] (12);
        [bkthin5s$2 bkthin6s$2 bkthin7s$2] (12);
        [bkthin1f$3 bkthin1s$3 bkthin2s$3 bkthin3s$3 bkthin4s$3] (13);
        [bkthin5s$3 bkthin6s$3 bkthin7s$3]  (13);
       

        [harmo1f$1 harmo1s$1 harmo2s$1 harmo3s$1 harmo4s$1] (21);
        [harmo5s$1 harmo6s$1 harmo7s$1] (21);
        [harmo1f$2 harmo1s$2 harmo2s$2 harmo3s$2 harmo4s$2] (22);
        [harmo5s$2 harmo6s$2 harmo7s$2] (22);
        [harmo1f$3 harmo1s$3 harmo2s$3 harmo3s$3 harmo4s$3] (23);
        [harmo5s$3 harmo6s$3 harmo7s$3] (23);
       

        [takep1f$1 takep1s$1 takep2s$1 takep3s$1 takep4s$1] (31);
        [takep5s$1 takep6s$1 takep7s$1] (31);
        [takep1f$2 takep1s$2 takep2s$2 takep3s$2 takep4s$2] (32);
        [takep5s$2 takep6s$2 takep7s$2] (32);
        [takep1f$3 takep1s$3 takep2s$3 takep3s$3 takep4s$3] (33);
        [takep5s$3 takep6s$3 takep7s$3] (33);
       
	
        ib sb qb |f1b@0 f2b@.5 f3b@1.5 f4b@2.5 
        f5b@3.5 f6b@4.5 f7b@5.5 f8b@6.5;
 
!        bkthin1f-takeP7s@0;

  

output:
        tech1 tech8;! standardized;

plot:
 !   type = plot2;
