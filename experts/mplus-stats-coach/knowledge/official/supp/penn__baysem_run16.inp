title:

montecarlo:
      names = y1-y10;
      nobs = 500;
      nreps = 500;

model population:
      f1 by y1-y5*.8 y6-y10@.0;
      f2 by y1-y5@0 y6-y10*.8;
     
      f1-f2@1;
      f1 with f2*.5;
     
      y1-y10*.36;

      y1 with y6*.3;
      y2 with y7*.3;


analysis:
    estimator = ml;
    process = 2;


model:
    f1 by y1@.8 y2-y5*.8 y6-y10@.0;
    f2 by y1-y5@0 y6@.8 y7-y10*.8;
     
    f1-f2*1 (v1-v2);
    f1 with f2*.5 (c12);
     
    y1-y10*.36;

    
model constraint:
    New(r12*.5);
    r12 = c12/(sqrt(v1)*sqrt(v2));

output:
    tech9;

