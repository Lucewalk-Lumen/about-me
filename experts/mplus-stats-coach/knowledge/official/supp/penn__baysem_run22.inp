TITLE:
    CFA using ML
DATA: 
	FILE = asb.dat;
    FORMAT = 34X 54F2.0;
VARIABLE: 
	NAMES = property fight shoplift lt50 gt50 force threat injure pot drug 
	soldpot solddrug con auto bldg goods gambling
	dsm1-dsm22 sex black hisp single divorce dropout college onset f1 f2 f3
	age94 cohort dep abuse;
        
    USEVAR = property-gambling;   
    CATEGORICAL = property-gambling; 
     
ANALYSIS:  
    type = EFA 3 3;
    ESTIMATOR = ML;
    PROCESS = 2;

output:
    tech8 stdy;

plot: type = plot3;