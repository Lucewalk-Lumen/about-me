title:

montecarlo:
      names = y1-y10;
      nobs = 500;
      nreps = 500;

model population:
      f1 by y1-y5*.8 y6-y10@.0;
      f2 by y1-y5@0 y6-y10*.8;
     
      f1-f2@1;
      f1 with f2*.5;
     
      y1-y10*.36;

      y1 with y6*.1;
      y2 with y7*.1;


analysis:
    estimator = bayes;
    process = 2;


model:
    f1 by y1@.8 y2-y5*.8 y6-y10@.0;
    f2 by y1-y5@0 y6@.8 y7-y10*.8;
     
    f1-f2*1 (fv1-fv2);
    f1 with f2*.5 (fc12);
     
    y1-y10*.36 (yv1-yv10);

    fy1 by y1;
    fy2 by y2;
    fy3 by y3;
    fy4 by y4;
    fy5 by y5;
    fy6 by y6;
    fy7 by y7;
    fy8 by y8;
    fy9 by y9;
    fy10 by y10;

    fy1-fy10 with f1-f2@0;

    fy1-fy10 (p1-p10);
    fy1 with fy2-fy5 fy6*.1 fy7-fy10 (p11-p19);
    fy2 with fy3-fy6 fy7*.1 fy8-fy10 (p20-p27);
    fy3 with fy4-fy10 (p28-p34);
    fy4 with fy5-fy10 (p35-p40);
    fy5 with fy6-fy10 (p41-p45);
    fy6 with fy7-fy10 (p46-p49);
    fy7 with fy8-fy10 (p50-p52);
    fy8 with fy9-fy10 (p53-p54);
    fy9 with fy10 (p55);

model priors:
    
    p1-p10~IW(1,14);
    p11-p55~IW(0,14);

model constraint:
    new(fr12*.5 yr12*0 yr16*.438 fyr12*0 fyr16*.5);
   
    !fr is factor correlation
    !yr is observed variable residual correlation
    !fyr is residual correlation among the underlying factors

     fr12 = fc12/(sqrt(fv1)*sqrt(fv2));

    yr12 = p11/(sqrt(yv1+p1)*sqrt(yv2+p2));
    yr16 = p15/(sqrt(yv1+p1)*sqrt(yv6+p6));

    fyr12 = p11/(sqrt(p1)*sqrt(p2));
    fyr16 = p15/(sqrt(p1)*sqrt(p6));

output:
    tech9;

