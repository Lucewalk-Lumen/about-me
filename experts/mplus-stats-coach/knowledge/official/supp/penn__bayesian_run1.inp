title:
    Mediation using Bayesian analysis
    ATLAS data from MacKinnon et al. (2004), MBR

    Step 1

data:
    file = mbr2004atlas.txt;

variable:
    names = obs group severity nutrit;
    usev = group - nutrit;

analysis:
    estimator = bayes;
    process = 2;

model:
    severity on group (a);
    nutrit on severity (b)
    group;

model constraint:
    new(indirect);
    indirect = a*b;

output:
    tech1 tech8 standardized;

plot:
    type = plot2;
