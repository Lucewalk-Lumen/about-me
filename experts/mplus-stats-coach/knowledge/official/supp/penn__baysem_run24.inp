title:

montecarlo:
      names = y1-y15 x;
      nobs = 500;
      nreps = 500;
      cutpoints = x(0);
      generate = y1-y15(1);
      categorical = y1-y15;

model population:
      x@1;
      f1 by y1-y5*1 y6-y10@.0 y11-y15@0;
      f2 by y1-y5@0 y6-y10*1 y11-y15@0;
      f3 by y1-y5@.0 y6-y10@0 y11-y15*1;
      f1-f3@1;
      f1 with f2-f3*.5;
      f2 with f3*.5;
     
     ! V(u*) = 1*1 + 1

       f1-f3 on x*.5;

    y1 on x*.4;
    y6 on x*.4;
    y11 on x*.4;

analysis:
    estimator = bayes;
    process = 2;


model:

      f1 by y1@1 y2-y5*1 y6-y15@0;
      f2 by y1-y5@0 y6@1 y7-y10*1 y11-y15@0;
      f3 by y1-y10@0 y11@1 y12-y15*1;
      f1-f3*1 (v1-v3);
      f1 with f2*.5 (c21);
      f1 with f3*.5 (c31);
      f2 with f3*.5 (c32);
     

      f1-f3 on x*.5;

      y1 on x*.4 (p1);
      y2 on x*.0 (p2);
      y3 on x*0 (p3);
      y4 on x*0 (p4);
      y5 on x*0 (p5);
      y6 on x*.4 (p6);
      y7 on x*.0 (p7);
      y8 on x*0 (p8);
      y9 on x*0 (p9);
      y10 on x*0 (p10);
      y11 on x*.4 (p11);
      y12 on x*.0 (p12);
      y13 on x*0 (p13);
      y14 on x*0 (p14);
      y15 on x*0 (p15);

model priors:

    p1-p15~N(0,0.04);
    ! V(u*)=2, i.e SD=1.4, so that a medium direct effect of half a SD is 0.7
    ! and a small effect of 0.3 SD is 0.42.
    ! Letting the 95% limit be 0.4 results in prior variance
    ! of 0.04 (1.96*sqrt(0.04)=0.4).

model constraint:
      new(r21*.5 r31*.5 r32*.5);
      r21 = c21/(sqrt(v1)*sqrt(v2));
      r31 = c31/(sqrt(v1)*sqrt(v3));
      r32 = c32/(sqrt(v2)*sqrt(v3));

   

output:
      tech9;

