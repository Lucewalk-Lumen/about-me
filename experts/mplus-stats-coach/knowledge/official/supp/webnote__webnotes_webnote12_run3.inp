title: M10 model

variable:  NAMES ARE y1-y5;

data: file=1.dat;

analysis: estimator=mlr; convergence=100000000;

model: 
     y3 with y2*0; 

     f1 BY y1@1;
     f1 BY y2*0.599;
     f1 BY y3*0.814;
     f1 BY y4*0.893;
     f1 BY y5*0.818;

     y1 WITH y2*-0.031;

     [ y1*0.280 ];
     [ y2*0.380 ];
     [ y3*0.400 ];
     [ y4*0.420 ];
     [ y5*0.420 ];

     y1*0.167;
     y2*0.337;
     y3*0.378;
     y4*0.385;
     y5*0.420;
     f1*0.274;

output: tech5;