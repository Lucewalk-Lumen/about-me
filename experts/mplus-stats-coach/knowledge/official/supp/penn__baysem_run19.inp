title:

  montecarlo:
        names = y1-y10;
        nobs = 200;
        nreps = 500;

  model population:
        f1 by y1-y5*.8 y6-y10@.0;
        f2 by y1-y5@0 y6-y10*.8;

        f1-f2@1;
        f1 with f2*.5;

        y1-y10*.36;

        y1 with y6*.3;
        y2 with y7*.3;


  analysis:
      estimator = bayes;
      process = 2; 
      fbiter = 50000;

  model:
      f1 by y1@.8 y2-y5*.8 y6-y10@.0;
      f2 by y1-y5@0 y6@.8 y7-y10*.8;

      f1-f2*1 (v1-v2);
      f1 with f2*.5 (c21);

      y1-y10*.36 (p1-p10);
      y1 with y2-y5 y6*.3 y7-y10 (p11-p19);
      y2 with y3-y6 y7*.3 y8-y10 (p20-p27);
      y3 with y4-y10 (p28-p34);
      y4 with y5-y10 (p35-p40);
      y5 with y6-y10 (p41-p45);
      y6 with y7-y10 (p46-p49);
      y7 with y8-y10 (p50-p52);
      y8 with y9-y10 (p53-p54);
      y9 with y10 (p55);

  model priors:

      p1-p10~IW(1,30);
      p11-p55~IW(0,30);

  model constraint:
      new(r21*.5);
      r21 = c21/(sqrt(v1)*sqrt(v2));

  output:
      tech9;