TITLE:
    cFA using Bayes 
DATA: 
	FILE = asb.dat;
    FORMAT = 34X 54F2.0;
VARIABLE: 
	NAMES = property fight shoplift lt50 gt50 force threat injure pot drug 
	soldpot solddrug con auto bldg goods gambling
	dsm1-dsm22 male black hisp single divorce dropout college onset f1 f2 f3
	age94 cohort dep abuse;
        
    USEVAR = property-gambling age94 male black;   
    CATEGORICAL = property-gambling; 
     
ANALYSIS:  
    ESTIMATOR = Bayes;
    PROCESS = 2;
    fbiter = 100000;

model:
    prop by property shoplift lt50 gt50 con auto bldg goods gambling;
    person by fight force threat injure gambling;
    drugs by pot drug soldpot solddrug;

    prop-drugs on age94 male black;

    ! cross-loadings:

    prop by fight*0 (a1)
     force-solddrug*0 (a2-a8);
    person by property*0 (b1)
     shoplift-gt50*0 (b2-b4)
     pot-goods*0 (b5-b12);
    drugs by property-injure*0 (c1-c8)
     con-gambling*0 (c9-c13);

     ! direct effects:

     property-gambling on age94-black (d1-d51);
 
!     property on age94-black (d1-d3);
!     shoplift on age94-black (d7-d9);
!     lt50 on age94-black (d10-d12);
!     gt50 on age94-black (d13-d15);
!     force on age94-black (d16-d18);
!     threat on age94-black (d19-d21);
!     injure on age94-black (d22-d24);
!     pot on age94-black (d25-d27);
!     drug on age94-black (d28-d30);
!     soldpot on age94-black (d31-d33);
!     solddrug on age94-black (d34-d36);
!     con on age94-black (d37-d39);
!     auto on age94-black (d40-d42);
!     bldg on age94-black (d43-d45);
!     goods on age94-black (d46-d48);
!     gambling on age94-black (d49-d51);


model priors:
    a1-a8~N(0,0.01);
    b1-b12~N(0,0.01);
    c1-c13~N(0,0.01);

    d1-d51~N(0,0.04);

output:
    tech8 stdy;

plot: type = plot2;