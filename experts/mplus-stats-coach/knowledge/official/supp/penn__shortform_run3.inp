title: 
    Simulating x-m interaction effect on y using a random slope,
    saving the data for external Monte Carlo analysis:
    Binary Y, continuous M

montecarlo:
    names = y m x;
    generate = y(1 p);
    categorical = y;
    nobs = 200;
    nreps = 500;
    repsave = all;
    save = n200xmrep*.dat;
    cutpoints = x(0);
   
model population:
    x@1;
    [y$1*.5];
    y on x*.3;
    beta1 | y on m;
    beta1 on x*.2;
    [beta1*.7];
    beta1@0;
    [m*.5];
    m on x*.5;
    m*.75;

analysis:
    type = random;
    estimator = ml;
    link = probit;

model:
    [y$1*.5] (beta0);
    y on x*.3 (beta2);
    beta1 | y on m;
    beta1 on x*.2 (beta3);
    [beta1*.7] (beta1);
    beta1@0;
    [m*.5] (gamma0);
    m on x*.5 (gamma1);
    m*.75;

model constraint:
    new(ind*.45 dir*.4);
    ind=beta1*gamma1+beta3*gamma1;
    dir=beta3*gamma0+beta2;

