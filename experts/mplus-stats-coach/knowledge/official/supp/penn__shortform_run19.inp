title: 
    Nominal M, Binary Y
    Using a latent class variable to represent M
data:
    file = nombin.dat;

variable:
    names = x m y w;
    freqweight = w;
    usev = y x;
    categorical = y;
    classes = c(3);
    knownclass = c(m=1 m=2 m=3);

analysis:
    type = mixture;
    estimator = ml;

model:
    %overall%
    [c#1] (gamma01);
    [c#2] (gamma02);
    c#1 on x (gamma11);
    c#2 on x (gamma12);
    y on x;
    %c#1%
    [y$1] (beta01);
    y on x (beta11);
    %c#2% 
    [y$1] (beta02);
    y on x (beta12);
    %c#3%
    [y$1] (beta03);
    y on x (beta13);

model constraint:
    new(denom0 denom1 p10 p11 p20 p21 p30 p31 term11 term10 term01 term00
    de tie total pie orde ortie orpie);
    ! index is x' for multinomial denominator
    denom0=exp(gamma01)+exp(gamma02)+1;
    denom1=exp(gamma01+gamma11)+exp(gamma02+gamma12)+1;
    ! first index is class, second x' for probabilities
    p10=exp(gamma01)/denom0;
    p11=exp(gamma01+gamma11)/denom1;
    p20=exp(gamma02)/denom0;
    p21=exp(gamma02+gamma12)/denom1;
    p30=1/denom0;
    p31=1/denom1;
    ! first index is x, second x', summing over class
    term11=(1/(1+exp(beta01-beta11)))*p11+(1/(1+exp(beta02-beta12)))*p21
    +(1/(1+exp(beta03-beta13)))*p31;
    term10=(1/(1+exp(beta01-beta11)))*p10+(1/(1+exp(beta02-beta12)))*p20
    +(1/(1+exp(beta03-beta13)))*p30;
    term01=(1/(1+exp(beta01)))*p11+(1/(1+exp(beta02)))*p21
    +(1/(1+exp(beta03)))*p31;
    term00=(1/(1+exp(beta01)))*p10+(1/(1+exp(beta02)))*p20
    +(1/(1+exp(beta03)))*p30;
    de=term10-term00;
    tie=term11-term10;
    total=term11-term00;
    pie=term01-term00;
    orde=(term10/(1-term10))/(term00/(1-term00));
    ortie=(term11/(1-term11))/(term10/(1-term10));
    orpie=(term01/(1-term01))/(term00/(1-term00));

output:
    tech1 tech8;
    
