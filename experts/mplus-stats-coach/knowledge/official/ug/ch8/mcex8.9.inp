title: this is an example of a LCGA for a binary 
            outcome
montecarlo:
	names are u1-u4;
	generate = u1-u4(1);
	categorical = u1-u4;
	genclasses = c(2);
	classes = c(2);
	nobs = 500;
	seed = 3454367;
	nrep = 1;
	save = ex8.9.dat;

ANALYSIS:  
	TYPE = MIXTURE;

model population:
	%overall%
	i s | u1@0 u2@1 u3@2 u4@3;
	[i*1 s*1];
	[u1$1-u4$1*1] (1);

	%c#2%

	[i@0 s*0];

MODEL:
     %overall%
	i s | u1@0 u2@1 u3@2 u4@3;
	[i*1 s*1];
	[u1$1-u4$1*1] (1);

	%c#2%

	[i@0 s*0];


OUTPUT:    
	tech8 tech9;