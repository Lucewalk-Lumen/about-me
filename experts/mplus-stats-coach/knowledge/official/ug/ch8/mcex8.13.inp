TITLE:  this is an example of LTA with a
        binary covariate representing group

MONTECARLO:
  	NAMES = u11-u15 u21-u25 g;
  	GENERATE = u11-u15 u21-u25 g(1);
  	CATEGORICAL = u11-u15 u21-u25 g;
  	GENCLASSES = cg(2) c1(3) c2(3);
  	CLASSES = cg(2) c1(3) c2(3);
  	NOBSERVATION = 2000;
  	NREPS = 1;
    save = ex8.13.dat;

ANALYSIS:
  	TYPE=MIXTURE;
  	PARAMETERIZATION=PROBABILITY;
    ! the same results can be obtained with regular parameterization
   
MODEL POPULATION:
  	%OVERALL%
      [cg#1*0.5];
      c1#1 on cg#1*0.5; c1#2 on cg#1*0.2;
      c1#1 on cg#2*0.2; c1#2 on cg#2*0.5;

MODEL POPULATION-cg:
  	%cg#1%
    [g$1@15]; ! does the same as KNOWNCLASS
  	c2#1 on c1#1*0.5; c2#2 on c1#1*0.2;
  	c2#1 on c1#2*0.2; c2#2 on c1#2*0.3;
    c2#1 on c1#3*0.2; c2#2 on c1#3*0.2;

  	%cg#2% 
    [g$1@-15];
  	c2#1 on c1#1*0.2; c2#2 on c1#1*0.5;
  	c2#1 on c1#2*0.3; c2#2 on c1#2*0.2;
    c2#1 on c1#3*0.2; c2#2 on c1#3*0.2;


MODEL POPULATION-c1:
  	%c1#1% 
  	[u11$1*1] (1); 
  	[u12$1*1] (2);
  	[u13$1*1] (3);
  	[u14$1*1] (4);
    [u15$1*1] (5);

    %c1#2%
  	[u11$1*1] (6); 
  	[u12$1*1] (7);
  	[u13$1*-1] (8);
  	[u14$1*-1] (9);
    [u15$1*-1] (10);

  	%c1#3%
  	[u11$1*-1] (11); 
  	[u12$1*-1] (12);
  	[u13$1*-1] (13);
  	[u14$1*-1] (14);
    [u15$1*-1] (15);


MODEL POPULATION-c2:
    %c2#1% 
  	[u21$1*1] (1); 
  	[u22$1*1] (2);
  	[u23$1*1] (3);
  	[u24$1*1] (4);
    [u25$1*1] (5);

    %c2#2%
  	[u21$1*1] (6); 
  	[u22$1*1] (7);
  	[u23$1*-1] (8);
  	[u24$1*-1] (9);
    [u25$1*-1] (10);

  	%c2#3%
  	[u21$1*-1] (11); 
  	[u22$1*-1] (12);
  	[u23$1*-1] (13);
  	[u24$1*-1] (14);
    [u25$1*-1] (15);

 
 MODEL:
  	%OVERALL%
      [cg#1*0.5];
      c1#1 on cg#1*0.5; c1#2 on cg#1*0.2;
      c1#1 on cg#2*0.2; c1#2 on cg#2*0.5;

MODEL cg:
  	%cg#1%
    [g$1@15]; ! does the same as KNOWNCLASS
  	c2#1 on c1#1*0.5; c2#2 on c1#1*0.2;
  	c2#1 on c1#2*0.2; c2#2 on c1#2*0.3;
    c2#1 on c1#3*0.2; c2#2 on c1#3*0.2;

  	%cg#2% 
    [g$1@-15];
  	c2#1 on c1#1*0.2; c2#2 on c1#1*0.5;
  	c2#1 on c1#2*0.3; c2#2 on c1#2*0.2;
    c2#1 on c1#3*0.2; c2#2 on c1#3*0.2;


MODEL c1:
  	%c1#1% 
  	[u11$1*1] (1); 
  	[u12$1*1] (2);
  	[u13$1*1] (3);
  	[u14$1*1] (4);
    [u15$1*1] (5);

    %c1#2%
  	[u11$1*1] (6); 
  	[u12$1*1] (7);
  	[u13$1*-1] (8);
  	[u14$1*-1] (9);
    [u15$1*-1] (10);

  	%c1#3%
  	[u11$1*-1] (11); 
  	[u12$1*-1] (12);
  	[u13$1*-1] (13);
  	[u14$1*-1] (14);
    [u15$1*-1] (15);


MODEL c2:
    %c2#1% 
  	[u21$1*1] (1); 
  	[u22$1*1] (2);
  	[u23$1*1] (3);
  	[u24$1*1] (4);
    [u25$1*1] (5);

    %c2#2%
  	[u21$1*1] (6); 
  	[u22$1*1] (7);
  	[u23$1*-1] (8);
  	[u24$1*-1] (9);
    [u25$1*-1] (10);

  	%c2#3%
  	[u21$1*-1] (11); 
  	[u22$1*-1] (12);
  	[u23$1*-1] (13);
  	[u24$1*-1] (14);
    [u25$1*-1] (15);


OUTPUT: TECH9;
