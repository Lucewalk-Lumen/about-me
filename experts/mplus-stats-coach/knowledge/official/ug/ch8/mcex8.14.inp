TITLE:  this is an example of LTA with a
        continuous covariate 

MONTECARLO:
  	NAMES = u11-u15 u21-u25 x;
  	GENERATE = u11-u15 u21-u25(1);
  	CATEGORICAL = u11-u15 u21-u25;
  	GENCLASSES = c1(3) c2(3);
  	CLASSES = c1(3) c2(3);
  	NOBSERVATION = 2000;
  	NREPS = 1;
    save = ex8.14.dat;

ANALYSIS:
  	TYPE=MIXTURE;
  
MODEL POPULATION:
  	%OVERALL%
    [x@0]; x@1; 
    c1#1 on x*1.5; c1#2 on x*-0.5;
  	c2#1 on c1#1*0.5; c2#2 on c1#1*0.2;
  	c2#1 on c1#2*0.2; c2#2 on c1#2*0.3;

MODEL POPULATION-c1:
  	%c1#1% 
    ! parameterization 2 in Mplus Web Note 13
    c2#1 ON x*-0.5; c2#2 ON x*1.5;
  	[u11$1*1] (1); 
  	[u12$1*1] (2);
  	[u13$1*1] (3);
  	[u14$1*1] (4);
    [u15$1*1] (5);

    %c1#2%
    c2#1 ON x*1.5; c2#2 ON x*-0.5;
  	[u11$1*1] (6); 
  	[u12$1*1] (7);
  	[u13$1*-1] (8);
  	[u14$1*-1] (9);
    [u15$1*-1] (10);

  	%c1#3%
    c2#1 ON x*0.8; c2#2 ON x*-0.8;
  	[u11$1*-1] (11); 
  	[u12$1*-1] (12);
  	[u13$1*-1] (13);
  	[u14$1*-1] (14);
    [u15$1*-1] (15);


MODEL POPULATION-c2:
    %c2#1% 
  	[u21$1*1] (1); 
  	[u22$1*1] (2);
  	[u23$1*1] (3);
  	[u24$1*1] (4);
    [u25$1*1] (5);

    %c2#2%
  	[u21$1*1] (6); 
  	[u22$1*1] (7);
  	[u23$1*-1] (8);
  	[u24$1*-1] (9);
    [u25$1*-1] (10);

  	%c2#3%
  	[u21$1*-1] (11); 
  	[u22$1*-1] (12);
  	[u23$1*-1] (13);
  	[u24$1*-1] (14);
    [u25$1*-1] (15);

 
 MODEL:
   	%OVERALL%
    c1#1 on x*1.5; c1#2 on x*-0.5;
  	c2#1 on c1#1*0.5; c2#2 on c1#1*0.2;
  	c2#1 on c1#2*0.2; c2#2 on c1#2*0.3;

MODEL c1:
  	%c1#1% 
    ! parameterization 2 in Mplus Web Note 13
    c2#1 ON x*-0.5; c2#2 ON x*1.5;
  	[u11$1*1] (1); 
  	[u12$1*1] (2);
  	[u13$1*1] (3);
  	[u14$1*1] (4);
    [u15$1*1] (5);

    %c1#2%
    c2#1 ON x*1.5; c2#2 ON x*-0.5;
  	[u11$1*1] (6); 
  	[u12$1*1] (7);
  	[u13$1*-1] (8);
  	[u14$1*-1] (9);
    [u15$1*-1] (10);

  	%c1#3%
    c2#1 ON x*0.8; c2#2 ON x*-0.8;
  	[u11$1*-1] (11); 
  	[u12$1*-1] (12);
  	[u13$1*-1] (13);
  	[u14$1*-1] (14);
    [u15$1*-1] (15);

MODEL c2:
    %c2#1% 
  	[u21$1*1] (1); 
  	[u22$1*1] (2);
  	[u23$1*1] (3);
  	[u24$1*1] (4);
    [u25$1*1] (5);

    %c2#2%
  	[u21$1*1] (6); 
  	[u22$1*1] (7);
  	[u23$1*-1] (8);
  	[u24$1*-1] (9);
    [u25$1*-1] (10);

  	%c2#3%
  	[u21$1*-1] (11); 
  	[u22$1*-1] (12);
  	[u23$1*-1] (13);
  	[u24$1*-1] (14);
    [u25$1*-1] (15);


OUTPUT: TECH9;
