title:
	this is an example of a LCGA for a count 
	outcome using a zero-inflated Poisson 
	model

montecarlo:
	names are u1-u4;
	generate = u1-u4(ci);
	count = u1-u4(i);
	genclasses = c(2);
	classes = c(2);
	nobs = 500;
	seed = 3454367;
	nrep = 1;
	save = ex8.11.dat;

analysis:
	type = mixture;
	algo = int;

model population:

	%overall%

	i s | u1@0 u2@1 u3@2 u4@3;
	[i*.5 s*0];

	ii si | u1#1@0 u2#1@1 u3#1@2 u4#1@3;
	[ii@0]
	[si*-.5] (1);
	[u1#1-u4#1*.5] (2);

	i-si@0;
	i with s-si@0;
	s with ii-si@0;
	ii with si@0;

	%c#1%
	[i*1 s*.2];

model:

	%overall%

	i s | u1@0 u2@1 u3@2 u4@3;
	[i*.5 s*0];

	ii si | u1#1@0 u2#1@1 u3#1@2 u4#1@3;
	[ii@0]
	[si*-.5] (1);
	[u1#1-u4#1*.5] (2);

	i-si@0;
	i with s-si@0;
	s with ii-si@0;
	ii with si@0;

	%c#1%
	[i*1 s*.2];

output:
	tech8 tech9;
	
	
	

	
	