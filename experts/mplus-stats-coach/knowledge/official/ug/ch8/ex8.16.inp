TITLE: this is an example of a discrete-time
       survival mixture analysis with survival
       predicted by growth trajectory classes
DATA: FILE IS ex8.16.dat;
VARIABLE: NAMES ARE y1-y3 u1-u4;
	CLASSES = c(2);
	CATEGORICAL = u1-u4;
	MISSING = u1-u4 (999);
ANALYSIS: TYPE = MIXTURE;
MODEL:
	%OVERALL%
	i s | y1@0 y2@1 y3@2;
	f BY u1-u4@1;
OUTPUT: TECH1 TECH8;