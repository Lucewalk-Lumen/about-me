TITLE:	this is an example of a LCGA for a three-
	category outcome
DATA:	FILE IS ex8.10.dat;
VARIABLE:	NAMES ARE u1-u4 c;
	USEV = u1-u4;
	CLASSES = c(2);
	CATEGORICAL = u1-u4;
ANALYSIS:	TYPE = MIXTURE;
MODEL:	
	%OVERALL%
	i s | u1@0 u2@1 u3@2 u4@3;
!	[u1$1-u4$1*-.5] (1);
!	[u1$2-u4$2* .5] (2);
!	%c#1%
! 	[i*1 s*0];
!	%c#2% 
!	[i@0 s*0];
OUTPUT:	TECH1 TECH8;