TITLE:	this is an example of an N=1 time series analysis 
    with a first-order autoregressive AR(1) 
    IRT model with binary factor indicators
DATA:	FILE = ex6.27.dat;
VARIABLE:	NAMES = u1-u4;
	CATEGORICAL = u1-u4;
ANALYSIS:	ESTIMATOR = BAYES;
	PROCESSORS = 2;
	BITERATIONS = (2000);
MODEL:	f BY u1-u4*(&1); 
	f@1;
	f ON f&1;
OUTPUT:	TECH1 TECH8;
PLOT:	TYPE = PLOT3;
