title:	this is an example of a multiple group multiple
    cohort growth analysis

montecarlo:
	names = y1-y4 x a21-a24;
	ngroups = 3;
	nobs = 500 500 500;
	nreps = 1;
	save = ex6.18.dat;

model population:  !overall model and also cohort 1 (1990)

	[x@0 a21-a24@0]; x@1; a21-a24@1;
	
    i s |y1@0 y2@.2 y3@.4 y4@.6;
    [i*.5] (1);
    [s*1] (2);
    i*1 (3);
    s*.2 (4);
    i with s*.1 (5);
    i on x*1 (6);
    s on x*.3 (7);
    
    y1 on a21*.5;
    y2 on a22*.4 (12);
    y3 on a23*.3 (14);
    y4 on a24*.2 (16);

    y1*.5;
    y2-y4*.5 (22-24);
	
model population-g2: !cohort 2 (1989)

	i s |y1@.1 y2@.3 y3@.5 y4@.7;
    y1 on a21*.55;
    y2 on a22*.45;
    y3 on a23*.35;
    y4 on a24*.25;
	y1-y4*.5;

model population-g3: !cohort 3 (1988)

	i s |y1@.2 y2@.4 y3@.6 y4@.8;
    y1 on a21*.4 (12);
    y2 on a22*.3 (14);
    y3 on a23*.2 (16);
    y4 on a24*.2;
	y1-y3*.5 (22-24);
    y4*.5;

model:
	
    i s |y1@0 y2@.2 y3@.4 y4@.6;
    [i*.5] (1);
    [s*1] (2);
    i*1 (3);
    s*.2 (4);
    i with s*.1 (5);
    i on x*1 (6);
    s on x*.3 (7);

    y1 on a21*.5;
    y2 on a22*.4 (12);
    y3 on a23*.3 (14);
    y4 on a24*.2 (16);

    y1*.5;
    y2-y4*.5 (22-24);
	
model g2: !cohort 2 (1989)

	i s |y1@.1 y2@.3 y3@.5 y4@.7;
    y1 on a21*.55;
    y2 on a22*.45;
    y3 on a23*.35;
    y4 on a24*.25;
	y1-y4*.5;

model g3: !cohort 3 (1988)

	i s |y1@.2 y2@.4 y3@.6 y4@.8;
    y1 on a21*.4 (12);
    y2 on a22*.3 (14);
    y3 on a23*.2 (16);
    y4 on a24*.2;
	y1-y3*.5 (22-24);
    y4*.5;

output:
	tech9;

