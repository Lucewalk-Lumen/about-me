Title: N=1 bivariate cross-lagged analysis w latent variables

MONTECARLO:  NAMES ARE y11-y14 y21-y24;
             NOBS = 100;
             NREP = 1;         
             save = ex6.28.dat;
 
ANALYSIS:  
    		estimator=bayes;  
            biter=(500); 
            proc=2;
         
MODEL POPULATION:
    f1 by y11@1 y12-y14*1 (&1);
    f2 by y21@1 y22-y24*1 (&1);
    f1 on f1&1*.4 f2&1*.2;
    f2 on f2&1*.3 f1&1*.2;
    f1-f2*1;
    f1 with f2*.5;
    y11-y24*1; 
  
MODEL:
    f1 by y11@1 y12-y14*1 (&1);
    f2 by y21@1 y22-y24*1 (&1);
    f1 on f1&1*.4 f2&1*.2;
    f2 on f2&1*.3 f1&1*.2;
    f1-f2*1;
    f1 with f2*.5;
    y11-y24*1; 

output:
    tech8;