TITLE:	this is an example of an N=1 
        first-order autoregressive AR(1) CFA model
	with continuous factor indicators

montecarlo:
	names are y1-y4;
	nobservations = 200;
	nreps = 1;
    save = ex6.26.dat;

ANALYSIS:	

    estimator = bayes;
    proc = 2;
    biter = (2000);

MODEL POPULATION:

	f BY y1@1 
	y2*1 
	y3*1 
	y4*1 (&1);
	y1-y4*1;
    f on f&1*.3;
    f*1;

MODEL:
	
f BY y1@1 
	y2*1 
	y3*1 
	y4*1 (&1);
	y1-y4*1;
    f on f&1*.3;
    f*1;

output:
	tech8;
