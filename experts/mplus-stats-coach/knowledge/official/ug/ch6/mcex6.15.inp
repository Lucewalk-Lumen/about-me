title:	this is an example of a multiple indicator 
	linear growth model for continuous outcomes

montecarlo:
	names = u11 u21 u31 u12 u22 u32 u13 u23 u33;
	generate = u11-u33(1);
	categorical = u11-u33;
	nobs = 500;
	nreps = 1;
	save = ex6.15.dat;

model montecarlo:	

	f1 by	u11@1 
            u21*1 (1)
            u31*1 (2);
	f2 by 	u12@1 
			u22*1 (1)
			u32*1 (2);
	f3 by 	u13@1 
			u23*1 (1)
			u33*1 (2);

	[u11$1*-.5 u12$1*-.5 u13$1*-.5] (3);
	[u21$1*0 u22$1*0 u23$1*0] (4);
	[u31$1*.5 u32$1*.5 u33$1*.5] (5);

	u11-u33*.2;

	i s | f1@0 f2@1 f3@2;  

	[i@0 s*1];
	i*.4  s*0;   

	f1-f3*.4;   

	! the Delta parameterization of WLSMV assumes
	! V(u*) = 1, which is fulfilled with these 
	! population parameter values, so the metric
	! of the estimates will be correct

model:	

		f1 by	u11@1 
            u21*1 (1)
            u31*1 (2);
	f2 by 	u12@1 
			u22*1 (1)
			u32*1 (2);
	f3 by 	u13@1 
			u23*1 (1)
			u33*1 (2);

	[u11$1*-.5 u12$1*-.5 u13$1*-.5] (3);
	[u21$1*0 u22$1*0 u23$1*0] (4);
	[u31$1*.5 u32$1*.5 u33$1*.5] (5);

	{u11-u31@1 u12-u33*1};

	i s | f1@0 f2@1 f3@2;  

	[i@0 s*1];
	i*.4 s*0; 

	f1-f3*.4;   


output:
	tech9;
