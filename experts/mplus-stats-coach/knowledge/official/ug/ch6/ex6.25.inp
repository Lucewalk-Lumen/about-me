TITLE:      this is an example of an N=1 time series analysis with a 
            bivariate cross-lagged model for continuous outcomes
DATA:       FILE = ex6.25.dat;
VARIABLE:   NAMES = y1 y2;
            LAGGED = y1(1) y2(1);
ANALYSIS:   ESTIMATOR = BAYES;  
            PROCESSORS = 2;
            BITERATIONS = (500); 
MODEL:      y1 ON y1&1 y2&1;
            y2 ON y2&1 y1&1;  
OUTPUT:     TECH1 TECH8;
PLOT:       TYPE = PLOT3;