title:	this is an example of a discrete-time
	survival analysis
montecarlo:
	names = u1-u4 x;
	generate = u1-u4(1);
	categorical = u1-u4;
    missing = u2-u4;
	nobs = 500;
	nreps = 1;
	save = ex6.19.dat;

model population:
    [x@0]; x@1;
    [u1$1*2 u2$1*1.5 u3$1*1 u4$1*1];
	f by u1-u4@1;
    f on x*.5;
    f@0;

model missing:
    [u2-u4@-15]; ! Low logit intercepts give P(missing) = 0
    u2-u4 on u1@30; ! if u1=1, later u's are missing with certainty
    u3-u4 on u2@30; ! if u2=1, ...
    u4 on u3@30;  ! if u3=1, ...

analysis:
    estimator = mlr;

model:
    [u1$1*2 u2$1*1.5 u3$1*1 u4$1*1];
	f by u1-u4@1;
    f on x*.5;
    f@0;

output:
	tech8 tech9;

