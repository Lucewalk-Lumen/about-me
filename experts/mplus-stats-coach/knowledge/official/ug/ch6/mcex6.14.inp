title:	this is an example of a multiple indicator 
	linear growth model for continuous outcomes

montecarlo:
	names = y11 y21 y31 y12 y22 y32 y13 y23 y33;
	nobs = 500;
	nreps = 1;
	save = ex6.14.dat;

model montecarlo:	

	f1 BY	y11@1 
            y21*1 (1)
            y31*1 (2);
	f2 BY 	y12@1 
			y22*1 (1)
			y32*1 (2);
	f3 BY 	y13@1 
			y23*1 (1)
			y33*1 (2);

	[y11*-.5 y12*-.5 y13*-.5] (3);
	[y21*0 y22*0 y23*0] (4);
	[y31*.5 y32*.5 y33*.5] (5);

	y11-y33*.5;

	i s | f1@0 f2@1 f3@2;  

	[i@0 s*1];
	i*1 s*.2;   

	f1-f3*.4;   

model:	

	f1 BY	y11@1 
            y21*1 (1)
            y31*1 (2);
	f2 BY 	y12@1 
			y22*1 (1)
			y32*1 (2);
	f3 BY 	y13@1 
			y23*1 (1)
			y33*1 (2);

	[y11*-.5 y12*-.5 y13*-.5] (3);
	[y21*0 y22*0 y23*0] (4);
	[y31*.5 y32*.5 y33*.5] (5);

	y11-y33*.5;

	i s | f1@0 f2@1 f3@2;  

	[i@0 s*1];
	i*1 s*.2;   

	f1-f3*.4;    
 
