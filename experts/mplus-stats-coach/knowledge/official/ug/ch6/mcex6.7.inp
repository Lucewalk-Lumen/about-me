title:	this is an example of a linear growth 
	model for a count outcome using a zero-
	inflated Poisson model 

montecarlo:
	names = u11-u14;
	generate = u11-u14(ci);
	count = u11-u14(i);
	nobs = 500;
	nreps = 1;
	save = ex6.7.dat;

analysis:
	integration = 7;

model population:

	i s | u11@0 u12@1 u13@2 u14@3;
	[u11-u14@0]; 

	[i*.2 s*.005];
	i*.4; s@0;

	ii si | u11#1@0 u12#1@1 u13#1@2 u14#1@3;
	[u11#1-u14#1*-.5]; 

	[ii@0 si*-.2];
	ii*1; si@0;
	! inflation slope variance zero for simplicity
	si with i-ii@0;
	i with ii*-.32;
	! correlation is -0.5 between i and ii
	s with ii@0;

model:
	
	i s | u11@0 u12@1 u13@2 u14@3;
	[u11-u14@0]; 

	[i*.2 s*.005];
	i*.4; s@0;

	ii si | u11#1@0 u12#1@1 u13#1@2 u14#1@3;
	[u11#1-u14#1*-.5] (1); 

	[ii@0 si*-.2];
	ii*1; si@0;

	si with i-ii@0;
	i with ii*-.32;
	s with ii@0;


output:
	tech8 tech9;