Title: N=1 bivariate cross-lagged analysis

MONTECARLO:  NAMES ARE y1 y2;
             NOBS = 100;
             NREP = 1;
             lagged = y1(1) y2(1);
             save = ex6.25.dat;
 
ANALYSIS:  
    		estimator=bayes;  
            biter=(500); 
            proc=2;
         
MODEL MONTECARLO:
 
  y1 on y1&1*.2 y2&1*-.3;
  y2 on y2&1*.1 y1&1*.3;  
  y1-y2*1; 
  
MODEL:

  y1 on y1&1*.2 y2&1*-.3;
  y2 on y2&1*.1 y1&1*.3;  
  y1-y2*1; 

output:
    tech8;