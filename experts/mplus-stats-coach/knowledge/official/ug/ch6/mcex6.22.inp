title:	this is an example of a continuous-time survival analysis
    using a parametric model and a latent variable influencing
    survival
montecarlo:
	names = t x u1-u4;
	generate = t(s 20*1) u1-u4(1);
	hazardc = t (.05);
    survival = t(20*1);
    categorical = u1-u4;
	nobs = 1000;
	nreps = 1;
	save = ex6.22.dat;

model population:
    x@0;
    x@1;
    f by u1-u4*1;
    f@2;
    [u1$1-u4$1*0];
    [t#1-t#21*.05];
    t on x*.1 f*.05;
    f on x*.2;

analysis:
    basehazard = on;

model:
    f by u1@1 u2-u4*1;
    f*2;
    [u1$1-u4$1*0];
    [t#1-t#21*.05];
    t on x*.1 f*.05;
    f on x*.2;

output:
	tech8 tech9;

