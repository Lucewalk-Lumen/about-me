Title: this is an example of a univariate time-series analysis
        with lag-1 autoregression
MONTECARLO:  NAMES ARE y;
             NOBS = 100;
             NREP = 1;
             LAGGED = y(1);
             SAVE = ex6.23.dat;
MODEL MONTECARLO:
            y ON y&1*0.2;
            [y*.5]; y*1;
ANALYSIS:   ESTIMATOR = BAYES;  
            BITERATIONS = (2000); 
            PROCESSORS = 2;
MODEL:
            y ON y&1*0.2;
            [y*.5]; y*1; 
OUTPUT:     TECH8;

