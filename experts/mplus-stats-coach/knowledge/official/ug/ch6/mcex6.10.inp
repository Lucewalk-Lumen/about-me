title:	this is an example of a linear growth 
	model for a continuous outcome with time-
	invariant and time-varying covariates

montecarlo:
	names = y11-y14 x1 x2 a31-a34;
	nobs = 500;
	nreps = 1;
	save = ex6.10.dat;

model population:

	[x1-a34@0]; x1-a34@1;
	!uncorrelated by default

	i s | y11@0 y12@1 y13@2 y14@3;
	[y11-y14@0]; 
	y11-y14*.5;
	[i*.5 s*1];
	i*1; s*.2; i with s*.1;

	i on x1*.5 x2*.7;
	s on x1*.3 x2*.5;

	y11 on a31*.3;
	y12 on a32*.3;
	y13 on a33*.3;
	y14 on a34*.3;

model:
	
	i s | y11@0 y12@1 y13@2 y14@3;
	[y11-y14@0]; 
	y11-y14*.5;
	[i*.5 s*1];
	i*1; s*.2; i with s*.1;

	i on x1*.5 x2*.7;
	s on x1*.3 x2*.5;

	y11 on a31*.3;
	y12 on a32*.3;
	y13 on a33*.3;
	y14 on a34*.3;


output:
	tech9;

