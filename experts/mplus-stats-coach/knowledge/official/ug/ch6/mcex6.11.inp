title:		this is an example of a piecewise growth 
	model for a continuous outcome

montecarlo:
	names = y1-y5;
	nobs = 500;
	nreps = 1;
	save = ex6.11.dat;

model population:

	i s1 | y1@0 y2@1 y3@2 y4@2 y5@2;
	i s2 | y1@0 y2@0 y3@0 y4@1 y5@2;

	y1-y5*.5;
	[i*.5 s1*1 s2*2];
	i*1; s1-s2*.2; 

model:
	
	i s1 | y1@0 y2@1 y3@2 y4@2 y5@2;
	i s2 | y1@0 y2@0 y3@0 y4@1 y5@2;

	y1-y5*.5;
	[i*.5 s1*1 s2*2];
	i*1; s1-s2*.2; 

output:
	tech9;

