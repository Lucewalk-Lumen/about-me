TITLE:	this is an example of an N=1 
        first-order autoregressive AR(1) IRT model
	with binary indicators

montecarlo:
	names are u1-u4;
	nobservations = 200;
	nreps = 1;
    save = ex6.27.dat;
    generate = u1-u4(1);
  	categorical = u1-u4;

ANALYSIS:	

    estimator = bayes;
    proc = 2;
    biter = (2000);

MODEL POPULATION:

	f BY u1-u4*1 (&1); 
    f@1;
!	u1-u4*1;
    f on f&1*.3;

MODEL:
	
    f BY u1-u4*1(&1);
    f@1;
!	u1-u4*1;
    f on f&1*.3;

output:
	tech8;
