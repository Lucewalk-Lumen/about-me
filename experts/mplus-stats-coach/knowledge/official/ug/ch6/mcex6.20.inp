title:	this is an example of a continuous-time 
    survival analysis using the Cox regression model
montecarlo:
	names = t x;
	generate = t(s 20*1);
	hazardc = t (.5);
    survival = t;
	nobs = 50;
	nreps = 1;
	save = ex6.20.dat;

model population:
    x@0;
    x@1;
    [t#1-t#21*1];
    t on x*.5;

analysis:

model:
    t on x*.5;

output:
	tech8 tech9;

