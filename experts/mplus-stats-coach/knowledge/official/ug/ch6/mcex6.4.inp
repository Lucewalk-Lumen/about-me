title:		this is an example of a linear growth 
	model for a categorical outcome 
	This is the same example as in section 9.2 of
	Mplus Web Note #4, page 18

montecarlo:
	names = u11-u14;
	generate = u11-u14(1);
	categorical = u11 - u14;
	nobs = 500;
	nreps = 1;
	save = ex6.4.dat;

model population:

	i s | u11@0 u12@1 u13@2 u14@3;
	[u11$1-u14$1*-.5] (1); 
	u11*.5 u12*.6 u13*.9 u14*1.4;
	[i@0 s*-.5];
	i*.5; s*.1; i with s*0;

model:
	
	i s | u11@0 u12@1 u13@2 u14@3;
	[u11$1-u14$1*-.5] (1); 
	! residual variances are not part of the
	! default WLSMV Delta parameterization
	[i@0 s*-.5];
	i*.5; s*.1; i with s*0;
	{u11@1 u12*.913 u13*.745 u14*.598};	
	! this sets the scale factors at the inverted SDs
	! for the u* variables, so that the estimates
	! are in the metric of the Delta 
	! parametrizations 


output:
	tech9;

