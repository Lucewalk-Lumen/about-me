title:		this is an example of a linear growth 
	model for a categorical outcome 
	This uses ML and the logistic model

montecarlo:
	names = u11-u14;
	generate = u11-u14(1);
	categorical = u11 - u14;
	nobs = 500;
	nreps = 1;
	save = ex6.4logistic.dat;

analysis:
	estimator = mlr;

model population:

	i s | u11@0 u12@1 u13@2 u14@3;
	[u11$1-u14$1*-.5] (1); 

	[i@0 s*-.85];
	i*1.45; s*.29; i with s*0;

model:
	
	i s | u11@0 u12@1 u13@2 u14@3;
	[u11$1-u14$1*-.5] (1); 
	
	[i@0 s*-.85];
	i*1.45; s*.29; i with s*0;


output:
	tech8 tech9;

