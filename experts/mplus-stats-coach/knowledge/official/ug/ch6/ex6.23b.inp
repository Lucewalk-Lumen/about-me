TITLE:	this is an example of an N=1 time series analysis with a
    univariate second-order autoregressive AR(2) model for a
    continuous outcome
DATA:	FILE = ex6.23.dat;
VARIABLE:	NAMES = y;
	LAGGED = y(2);
ANALYSIS:	ESTIMATOR = BAYES;  
	PROCESSORS = 2;
	BITERATIONS = (2000); 
MODEL:	y ON y&1 y&2;
OUTPUT:	TECH1 TECH8;
PLOT:	TYPE = PLOT3;
