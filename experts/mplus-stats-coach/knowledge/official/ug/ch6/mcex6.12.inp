title:	this is an example of a growth model with 
	individually-varying times of observation 
	and random slopes for time-varying 
	covariates for a continuous outcome

montecarlo:
	names = y1-y4 x a11-a14 a21-a24;
	tscores = a11(0 0) a12(1 0.05) a13(2 0.05) a14(3 0.05);
	nobs = 500;
	nreps = 1;
	save = ex6.12.dat;

analysis:
	type = random;

model population:

	[x@0 a21-a24@0]; x@1 a21-a24@1;
	!uncorrelated by default

	i s | y1-y4 AT a11-a14;
	
	y1-y4*.5;

	st | y1 on a21;
	st | y2 on a22;
	st | y3 on a23;
	st | y4 on a24;
	
	[i*.5 s*1];
	i*1; s*.2; 

	[st*.5]; st*.4;

	i on x*.7;
	s on x*.3;
	st on x*.2;

model:
	
	i s | y1-y4 AT a11-a14;
	
	y1-y4*.5;

	st | y1 on a21;
	st | y2 on a22;
	st | y3 on a23;
	st | y4 on a24;
	
	[i*.5 s*1];
	i*1; s*.2; 

	i with s*0; !!this should not be needed

	[st*.5]; st*.4;

	i on x*.7;
	s on x*.3;
	st on x*.2;


output:
	tech8 tech9;

