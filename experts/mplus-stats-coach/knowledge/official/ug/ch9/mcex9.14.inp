TITLE:	this is an example of a two-level growth model
	for a continuous outcome (three-level analysis) with
	variation of a random slope on both the within and
	between levels

montecarlo:
	names are y1-y4 x a1-a4 w;
	nobservations = 500;
	ncsizes = 3;
	csizes = 10 (5) 50 (3) 30 (10);
	seed = 58459;
	nreps = 1;
	within = x a1-a4;
	between = w;
	save = ex9.14.dat;

ANALYSIS:	
	TYPE = TWOLEVEL RANDOM;
	algorithm = integration;
	integration = 10;

MODEL POPULATION:

	%WITHIN%
	x@1; a1-a4@1;
	iw sw | y1@0 y2@1 y3@2 y4@3;
	y1-y4*.5 (1);
	iw ON x*1;
	sw ON x*.2;
	iw*1; sw*.5;
	s* | y1 ON a1;
	s* | y2 ON a2;
	s* | y3 ON a3;
	s* | y4 ON a4;
	s*.5;

	%BETWEEN%
	w@1;
	ib sb | y1@0 y2@1 y3@2 y4@3;
	y1-y4@0;
	ib ON w*.5;
	sb ON w*.2;
	s ON w*.6;
	s with ib-sb@0;
	[ib*1 sb*.5 s*1];
	ib*.5; sb*.2; s*.3;

MODEL:

	%WITHIN%

	iw sw | y1@0 y2@1 y3@2 y4@3;
	y1-y4*.5 (1);
	iw ON x*1;
	sw ON x*.2;
	iw*1; sw*.5;
	s* | y1 ON a1;
	s* | y2 ON a2;
	s* | y3 ON a3;
	s* | y4 ON a4;
	s*.5;

	%BETWEEN%

	ib sb | y1@0 y2@1 y3@2 y4@3;
	y1-y4@0;
	ib ON w*.5;
	sb ON w*.2;
	s ON w*.6;
	s with ib-sb@0;
	[ib*1 sb*.5 s*1];
	ib*.5; sb*.2; s*.3;


output:
	tech8 tech9;