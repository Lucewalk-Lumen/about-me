Title: two-level reg of y on x with random AR(1),
    random intercept, random slope, and random variance 

MONTECARLO:  NAMES ARE y x w xm;
             NOBS = 5000;
             NREP = 1;
             NCSIZES = 1;
             CSIZES = 100(50);
             lagged = y(1) x(1);
             within = x;
             between = w xm;
             save = ex9.31.dat;
 
ANALYSIS:   TYPE = TWOLEVEL RANDOM;
    		estimator=bayes;  
               proc=2;
            biter=(1000); 
         
MODEL POPULATION:

  %WITHIN%
  x*1;
  sx | y on x;
  sy | y on y&1;
  logv | y; 
  x on x&1*.5;
 
  %BETWEEN%
  w-xm*1;
  [sx*.7]; [sy*.2]; [logv*0];
  y*0.3; sx*0.5; sy*.01; logv*.1;  
  y on w*.5 xm*.3;
  sy on w*.1 xm*.05;
  sx on w*.3 xm*.4;
  logv on w*.3 xm*.1;


MODEL:
 
  %WITHIN%
  x*1;
  sx | y on x;
  sy | y on y&1;
  logv | y; 
  x on x&1*.5;
 
  %BETWEEN%

  [sx*.7]; [sy*.2]; [logv*0];
  y*0.3; sx*0.5; sy*.01; logv*.1;  
  y on w*.5 xm*.3;
  sy on w*.1 xm*.05;
  sx on w*.3 xm*.4;
  logv on w*.3 xm*.1;

output:
    tech8;