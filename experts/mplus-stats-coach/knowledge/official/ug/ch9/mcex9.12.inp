TITLE:	this is an example of a two-level growth 
	model for a continuous outcome (three-
	level analysis)

	Note that the residual variance parameter 
	restrictions correspond to those of a 
	conventional 3-level analysis. 
	They can all be relaxed.

montecarlo:
	names are y1-y4 x w;
	nobservations = 1000;
	ncsizes = 3;
	csizes = 40 (5) 50 (10) 20 (15);
	seed = 58459;
	nreps = 1;
	within = x;
	between = w;
	save = ex9.12.dat;

ANALYSIS:	
	TYPE IS TWOLEVEL;

MODEL POPULATION:

	%WITHIN%
	x@1;
	iw sw | y1@0 y2@1 y3@2 y4@3;
	y1-y4*.5 (1);
	iw ON x*1;
	sw ON x*.2;
	iw*1; sw*.5;

	%BETWEEN%
	w@1;
	ib sb | y1@0 y2@1 y3@2 y4@3;
	y1-y4@0;
	ib ON w*.5;
	sb ON w*.2;
	[ib*1 sb*.5];
	ib*.5; sb*.2;

MODEL:

	%WITHIN%

	iw sw | y1@0 y2@1 y3@2 y4@3;
	y1-y4*.5 (1);
	iw ON x*1;
	sw ON x*.2;
	iw*1; sw*.5;

	%BETWEEN%

	ib sb | y1@0 y2@1 y3@2 y4@3;
	y1-y4@0;
	ib ON w*.5;
	sb ON w*.2;
	[ib*1 sb*.5];
	ib*.5; sb*.2;

output:
	tech8 tech9;
