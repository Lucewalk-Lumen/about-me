TITLE:	this is an example of a three-level growth model with 
	continuous factor indicators and one covariate on each of
    the three levels

montecarlo:
    names are y1-y4 x w z;
    nobservations = 7500;
    nreps = 1;
    CSIZES = 50[30(5)];
    ncsize = 1[1];	
    save = ex9.23.dat;
	WITHIN = x;
	BETWEEN = (level2) w (level3) z;

ANALYSIS:	TYPE = THREELEVEL; 

MODEL POPULATION: 

	%WITHIN%
	x@1;
	iw sw | y1@0 y2@1 y3@2 y4@3;
    iw ON x*1;
    sw on x*.5;
    iw*1 sw*.2;
    iw with sw*0;
    y1-y4*1;

	%BETWEEN Level2%
	w@1;
	ib2 sb2 | y1@0 y2@1 y3@2 y4@3;
    ib2 on w*.4;
    sb2 on w*.2;
    ib2*.5 sb2*.2;
    ib2 with sb2*0;
    y1-y4*.5;

    %Between Level3%
    z@1;
    ib3 sb3 | y1@0 y2@1 y3@2 y4@3;
    ib3 on z*.5;
    sb3 on z*.3;
    ib3*.5 sb3*.2;
    ib3 with sb3*0;
    y1-y4@0;
    [ib3*.5 sb3*.3];
    [y1-y4@0];

MODEL: 
	%WITHIN%
!	x@1;
	iw sw | y1@0 y2@1 y3@2 y4@3;
    iw ON x*1;
    sw on x*.5;
    iw*1 sw*.2;
    iw with sw*0;
    y1-y4*1;

	%BETWEEN Level2%
!	w@1;
	ib2 sb2 | y1@0 y2@1 y3@2 y4@3;
    ib2 on w*.4;
    sb2 on w*.2;
    ib2*.5 sb2*.2;
    ib2 with sb2*0;
    y1-y4*.5;

    %Between Level3%
!   z@1;
    ib3 sb3 | y1@0 y2@1 y3@2 y4@3;
    ib3 on z*.5;
    sb3 on z*.3;
    ib3*.5 sb3*.2;
    ib3 with sb3*0;
    y1-y4@0;
    [ib3*.5 sb3*.3];
    [y1-y4@0];

output:
	tech8 tech9;
