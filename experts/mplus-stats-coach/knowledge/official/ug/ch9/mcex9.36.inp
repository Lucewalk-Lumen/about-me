Title: two-level bivariate cross-lagged analysis w factors

MONTECARLO:  NAMES ARE y11-y14 y21-y24;
             NOBS = 20000;
             NREP = 1;
             NCSIZES = 1;
             CSIZES = 200(100);
             save = ex9.36.dat;
 
ANALYSIS:   TYPE = TWOLEVEL RANDOM;
    		estimator=bayes;  
            proc = 2;
            biter=(2000); 

MODEL POPULATION:

  %WITHIN%
    f1 by y11@1 y12-y14*1(&1); 
    y11-y14*.5; 
    f2 by y21@1 y22-y24*1(&1); 
    y21-y24*.5;
    f1-f2*1;
    f1 with f2*.25;
    s11 | f1 on f1&1;
    s12 | f1 on f2&1;
    s21 | f2 on f1&1;
    s22 | f2 on f2&1;
 
  %BETWEEN%
  fb1 by y11-y14*.5;
  fb2 by y21-y24*.5;
  fb1-fb2@1;
  fb1 with fb2*.5;
  y11-y24*.2;
  [s11*.2]; [s22*.3];
  s11-s22*.02; 
  [s12*.1]; [s21*.2];
  fb1 with s11-s22*0;
  fb2 with s11-s22*0;
  s11-s22 with s11-s22*0;
  
  
MODEL:

  
  %WITHIN%
    f1 by y11@1 y12-y14*1(&1); 
    y11-y14*.5; 
    f2 by y21@1 y22-y24*1(&1); 
    y21-y24*.5;
    f1-f2*1;
    f1 with f2*.25;
    s11 | f1 on f1&1;
    s12 | f1 on f2&1;
    s21 | f2 on f1&1;
    s22 | f2 on f2&1;
 
  %BETWEEN%
  fb1 by y11-y14*.5;
  fb2 by y21-y24*.5;
  fb1-fb2@1;
  fb1 with fb2*.5;
  y11-y24*.2;
  [s11*.2]; [s22*.3];
  s11-s22*.02; 
  [s12*.1]; [s21*.2];
   fb1 with s11-s22*0;
  fb2 with s11-s22*0;
  s11-s22 with s11-s22*0;
  

output:
    tech8;