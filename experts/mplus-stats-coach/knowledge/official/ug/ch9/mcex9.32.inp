Title: two-level bivariate cross-lagged analysis

MONTECARLO:  NAMES ARE y1 y2;
             NOBS = 5000;
             NREP = 1;
             NCSIZES = 1;
             CSIZES = 100(50);
             lagged = y1(1) y2(1);
             save = ex9.32.dat;
 
ANALYSIS:   TYPE = TWOLEVEL RANDOM;
    		estimator=bayes;  
            proc = 2;
            biter=(2000); 

  
MODEL POPULATION:

  %WITHIN%
 
  s1 | y1 on y1&1;
  s2 | y2 on y2&1;
  s12 | y1 on y2&1;
  s21 | y2 on y1&1;
  logvar1 | y1;
  logvar2 | y2;
  f by y1@1 y2@1;
  logvarf | f;
 
  %BETWEEN%
  y1-y2*0.3; s1-s21*.01; 
  [s1-s21*.2]; 
  logvar1*.1; logvar2*.1; logvarf*.1;
  [logvar1*0]; [logvar2*0]; [logvarf*0];
  
MODEL:

  %Within%
   
  s1 | y1 on y1&1;
  s2 | y2 on y2&1;
  s12 | y1 on y2&1;
  s21 | y2 on y1&1;
  logvar1 | y1;
  logvar2 | y2;
  f by y1@1 y2@1;
  logvarf | f;
 
  %BETWEEN%
  y1-y2*0.3; s1-s21*.01; 
  [s1-s21*.2]; 
  logvar1*.1; logvar2*.1; logvarf*.1;
  [logvar1*0]; [logvar2*0]; [logvarf*0];
  


output:
    tech8;