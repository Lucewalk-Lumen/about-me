TITLE:      this is an example of path analysis with cross-
            classified data
DATA:       FILE =   ex9.25.dat;
VARIABLE:   NAMES = y1 y2 x w z level2a level2b;
            CLUSTER = level2b level2a;
            WITHIN = x;
            BETWEEN = (level2a) w (level2b) z;
ANALYSIS:   TYPE = CROSSCLASSIFIED;
            ESTIMATOR = BAYES;
            PROCESSORS = 2;
MODEL:      %WITHIN%
            y2 ON y1 x;
            y1 ON x;
            %BETWEEN level2a%
            y1-y2 ON w;
            y1 WITH y2;
            %BETWEEN level2b%
            y1-y2 ON z;
            y1 WITH y2;
OUTPUT:     TECH1 TECH8;