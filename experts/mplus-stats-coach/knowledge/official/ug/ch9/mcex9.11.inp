TITLE:	this is an example of a two-level 
	multiple group CFA with continuous
	factor indicators

montecarlo:
	names are y1-y6;
	NGROUPS = 2;
	nobservations = 1000 800;
	ncsizes = 3 |2;
	csizes = 40 (5) 50 (10) 20 (15) | 80 (5) 40 (10);
	seed = 58459;
	nreps = 1;
	save = ex9.11.dat;

ANALYSIS:	TYPE = TWOLEVEL;


MODEL POPULATION:
	
	%WITHIN%
	fw1 BY y1@1 y2-y3*1;
	fw2 BY y4@1 y5-y6*1;
	y1-y6*4;
	fw1-fw2*2;
	fw1 WITH fw2*1;

	%BETWEEN%
	fb1 BY y1@1 y2-y3*1;
	fb2 BY y4@1 y5-y6*1;
	y1-y6*1;
	fb1-fb2*.5;
	fb1 WITH fb2*.25;

MODEL POPULATION-g2:

	%WITHIN%
	fw1 BY y2-y3*.7;
	fw2 BY y5-y6*.8;


MODEL:
	
	%WITHIN%
	fw1 BY y1@1 y2-y3*1;
	fw2 BY y4@1 y5-y6*1;
	y1-y6*4;
	fw1-fw2*2;
	fw1 WITH fw2*1;

	%BETWEEN%
	fb1 BY y1@1 y2-y3*1;
	fb2 BY y4@1 y5-y6*1;
	y1-y6*1;
	fb1-fb2*.5;
	fb1 WITH fb2*.25;

MODEL g2:
	%WITHIN%
	fw1 BY y2-y3*.7;
	fw2 BY y5-y6*.8;
