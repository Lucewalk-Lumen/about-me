  montecarlo:
  		names are u;
  		nobservations = 5000;
  		nreps = 1;
  		CSIZES = 50[100(1)]; ! 50 items and 100 subjects
  		ncsize = 1[1];
		generate=u(1);
		categorical=u;
        save = ex9.26.dat;

  ANALYSIS:  TYPE = cross random;
  		estimator=bayes; proc=2; 

  model population:
  		%within%

		! across subject variation
  		%between level2a%
		s | f BY u;
		f@1;
		u@0;

		! across item variation
  		%between level2b%
  		u*1.5; [u$1*0];
  		s*0.2; [s*1];

  model:
  		%within%

		! across subject variation
  		%between level2a%
		s | f BY u;
		f@1;
		u@0;

		! across item variation
  		%between level2b%
  		u*1.5; [u$1*0];
  		s*0.2; [s*1];

  output:
  		tech8 tech9;

