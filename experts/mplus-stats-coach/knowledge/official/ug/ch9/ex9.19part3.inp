TITLE:	    this is an example of a two-level MIMIC model with 
	        continuous factor indicators, random factor loadings,
            two covariates on within, and one covariate on between.
            Analyzed with random within- and fixed between-level 
            factor loadings with equality of the mean of the random
            within factor loadings and the between factor loadings
DATA:       FILE = ex9.19.dat;
VARIABLE:   NAMES = y1-y4 x1 x2 w clus;
            CLUSTER = clus;
            WITHIN = x1 x2;
            BETWEEN = w;
ANALYSIS:	TYPE = TWOLEVEL RANDOM; 
            ESTIMATOR = BAYES;
            PROCESSORS = 2;
            BITER = (1000);
MODEL:      %WITHIN%
	        s1-s4 | f BY y1-y4;
            f@1;
            f ON x1 x2;
	        %BETWEEN%
            fb BY y1-y4* (lam1-lam4);
            fb ON w;
            [s1-s4*1] (lam1-lam4);
OUTPUT:     TECH1 TECH8;
PLOT:       TYPE = PLOT2;
