TITLE:	this is an example of a random coefficient 
	regression
MONTECARLO:			
	NAMES = y x1 x2;
	NOBSERVATIONS = 500;
	NREPS = 1;
	SEED = 53487;
	SAVE = ex3.9.dat;
ANALYSIS:
	TYPE = RANDOM;
MODEL POPULATION:
	x1-x2@1; x1 with x2*.25;
	s | y ON x1;	
	[y*.5]; y*.8;
	[s*1]; s*.9;
	s with y*.5;
	y ON x2*.6;
	s ON x2*.3;	
MODEL:

	s | y ON x1;	
	[y*.5]; y*.8;
	[s*1]; s*.9;
	s with y*.5;
	y ON x2*.6;
	s ON x2*.3;	
OUTPUT:
	TECH8 TECH9;

