TITLE:	this is an example of a path analysis
		with categorical dependent variables
		using the theta parameterization
MONTECARLO:			
		NAMES = u1-u3 x1-x3;
		NOBSERVATIONS = 1000;
		NREPS = 1;
		SEED = 53487;
		GENERATE = u1(2) u2(1) u3(3);
		CATEGORICAL = u1-u3;
		SAVE = ex3.13.dat;	
MODEL POPULATION:
		[x1-x3@0];
		x1-x3@1;
		u1 ON x1*3 x2*2 x3*1;
		u2 ON x1*1 x2*2 x3*3;
		u3 ON u1*1 u2*-1 x2*2;
		[u1$1*-1 u1$2*1];
		[u2$1*0];
		[u3$1*-.5 u3$2*.5 u3$3*1.5];
		u1-u3*1;
ANALYSIS:
		PARAMETERIZATION = THETA;
MODEL:
		u1 ON x1*3 x2*2 x3*1;
		u2 ON x1*1 x2*2 x3*3;
		u3 ON u1*1 u2*-1 x2*2;
		[u1$1*-1 u1$2*1];
		[u2$1*0];
		[u3$1*-.5 u3$2*.5 u3$3*1.5];
OUTPUT:	TECH9;