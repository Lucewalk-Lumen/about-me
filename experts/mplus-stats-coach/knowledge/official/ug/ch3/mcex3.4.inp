TITLE:	this is an example of a probit regression
		for a binary or categorical observed 
		dependent variable with two covariates
MONTECARLO:			
			NAMES = u1 x1 x3;
			NOBSERVATIONS = 500;
			NREPS = 1;
			SEED = 53487;
			GENERATE = u1(1);
			CATEGORICAL = u1;
			SAVE = ex3.4.dat;	
MODEL POPULATION:
			[x1-x3@0];
			x1-x3@1;
			u1 ON x1*1 x3*2;
			[u1$1*1];
			u1*1;
MODEL:		u1 ON x1*1 x3*2;
			[u1$1*1];