TITLE:		this is an example of a path analysis
		with a categorical dependent variable and 
	a continuous mediating variable with missing data
MONTECARLO:			
			NAMES = y u x;
			NOBSERVATIONS = 500;
			NREPS = 1;
			SEED = 53487;
			GENERATE = u(1);
			CATEGORICAL = u;
			MISSING = y;
			SAVE = ex3.17.dat;	
ANALYSIS:
			ESTIMATOR = MLR;
			INTEGRATION = MONTECARLO;
MODEL POPULATION:
			[x@0]; x@1;
			y ON x*-1;
			y*1;
			[y*.5];
			u ON x*1 y*.5;
MODEL:
			y ON x*-1;
			y*1;
			[y*.5];
			u ON x*1 y*.5;
MODEL MISSING:
			y ON x@1;
			[y@-1];
OUTPUT:		TECH8 TECH9;
