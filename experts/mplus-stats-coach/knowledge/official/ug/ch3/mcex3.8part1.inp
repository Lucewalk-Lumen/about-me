TITLE:	this is an example of a zero-inflated 
		Poisson regression for a count dependent 
		variable with two covariates
MONTECARLO:			
		NAMES = u1 x1 x3;
		NOBSERVATIONS = 500;
		NREPS = 1;
		SEED = 53487;
		GENERATE = u1(pi);
		COUNT = u1(i);
		SAVE = ex3.8a.dat;	
MODEL POPULATION:
		[x1-x3@0];
		x1-x3@1;
		u1 ON x1*.5 x3*.3;
		[u1*1];
		u1#1 ON x1*2 x3*1;
		[u1#1*-1];
MODEL:
		u1 ON x1*.5 x3*.3;
		[u1*1];
		u1#1 ON x1*2 x3*1;
		[u1#1*-1];
OUTPUT:	TECH8;
