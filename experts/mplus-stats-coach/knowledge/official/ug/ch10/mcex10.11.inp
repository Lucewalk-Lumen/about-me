title:	monte carlo for a two-level LCGA for 
	a three-category outcome

montecarlo:
	names are u1-u4;
	nobservations = 1000;
	ncsizes = 3;
	csizes = 40 (5) 50 (10) 20 (15);
	generate = u1-u4(2);
	categorical = u1-u4;
	genclasses = c(2);
	classes = c(2);
	seed = 3454367;
	nrep = 1;
	save = ex10.11.dat;

analysis:  
	type = twolevel mixture;

model population:

	%within%

	%overall%

	i s | u1@0 u2@1 u3@2 u4@3;

	i-s@0; i with s@0;

	[i*1 s*1];

	%c#2%

	[i@0 s*0];


	%between%

	%overall%

	c#1*1;

	[u1$1-u4$1*1];
	[u1$2-u4$2*1.5];


model:

    %within%

	%overall%

	i s | u1@0 u2@1 u3@2 u4@3;

	i-s@0; i with s@0;

	[i*1 s*1];

	%c#2%

	[i@0 s*0];


	%between%

	%overall%

	c#1*1;

	[u1$1-u4$1*1] (1);
	[u1$2-u4$2*1.5] (2);


output:    
	tech8 tech9;
