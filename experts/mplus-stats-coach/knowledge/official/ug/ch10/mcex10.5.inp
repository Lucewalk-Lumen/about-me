TITLE:	this is an example of a Monte Carlo simulation study for a 
  two-level IRT mixture analysis with binary factor indicators and a 
  between-level categorical latent variable
montecarlo:
	names are u1-u8;
	generate = u1-u8(1);
	categorical = u1-u8;
	genclasses = cb(2 b) c(2);
	classes = cb(2) c(2);
	nobservations = 2000;
	ncsizes = 1;
	csizes = 100(20);
	between = cb;
	seed = 3454367;
	nrep = 1;
	save = ex10.5.dat;

analysis:
	type = twolevel mixture;

model population:

	%within%
	%overall%

    f by u1@1 u2-u8*1;
    [f@0];

	[c#1*0.5];

	%between%
	%overall%
	[cb#1*0];

	%cb#1.c#1%

	[u1$1*2 u2$1*2 u3$1*2 u4$1*2 u5$1*-2 u6$1*-2 u7$1*-2 u8$1*-2];

	%cb#1.c#2%

	[u1$1*-2 u2$1*-2 u3$1*-2 u4$1*-2 u5$1*2 u6$1*2 u7$1*2 u8$1*2];

	%cb#2.c#1%
	[u1$1*1 u2$1*1 u3$1*1 u4$1*1 u5$1*0 u6$1*0 u7$1*0 u8$1*0];

	%cb#2.c#2%
	[u1$1*-2 u2$1*-2 u3$1*-2 u4$1*2 u5$1*2 u6$1*2 u7$1*2 u8$1*2];



model population-c:
	%within%
	
	%c#1%
    f*3;

	%c#2%
    f*2;


model:

	%within%
	%overall%

    f by u1@1 u2-u8*1;
    [f@0];

	[c#1*0.5];

	%between%
	%overall%
	[cb#1*0];

	%cb#1.c#1%

	[u1$1*2 u2$1*2 u3$1*2 u4$1*2 u5$1*-2 u6$1*-2 u7$1*-2 u8$1*-2];

	%cb#1.c#2%

	[u1$1*-2 u2$1*-2 u3$1*-2 u4$1*-2 u5$1*2 u6$1*2 u7$1*2 u8$1*2];

	%cb#2.c#1%
	[u1$1*1 u2$1*1 u3$1*1 u4$1*1 u5$1*0 u6$1*0 u7$1*0 u8$1*0];

	%cb#2.c#2%
	[u1$1*-2 u2$1*-2 u3$1*-2 u4$1*2 u5$1*2 u6$1*2 u7$1*2 u8$1*2];



model c:
	%within%
	
	%c#1%
    f*3;

	%c#2%
    f*2;

output:
	tech8 tech9;
	
	
	

	
	