title:
	monte carlo for two-level CFA mixture model 
	with continuous factor indicators

montecarlo:
	names are y1-y5;
	nobservations = 1000;
	ncsizes = 3;
	csizes = 40 (5) 50 (10) 20 (15);
	genclasses = c(2);
	classes = c(2);
	seed = 3454367;
	nrep = 1;
	save = ex10.4.dat;

analysis:
	type = twolevel mixture;

model population:

	%within%

	%overall%

	[c#1*0];
	
	y1-y5*.25;
	fw by y1@1 
	y2*.8 
	y3*.8 
	y4*.8 
	y5*.8;

	fw*1;

	%between%

	%overall%

	fb by y1@1 
	y2*.8 
	y3*.8 
	y4*.8 
	y5*.8;

	[fb@0];
	fb*.5;

	c#1*1;

!	Possible model alternatives:
!	fb with c#1*.5; ! this model is allowed

!	fb on c#1*.5; ! this model is allowed

!	c#1 on fb*.5; ! this model is not internally consistent 
				! (reciprocity problem) and is disallowed


	%c#1%
	[fb*2];


model:
	
	%within%

	%overall%

	[c#1*0];
	
	y1-y5*.25;
	fw by y1@1 
	y2*.8 
	y3*.8 
	y4*.8
	y5*.8;

	fw*1;

	%between%

	%overall%

	fb by y1@1 
	y2*.8
	y3*.8
	y4*.8
	y5*.8;

	[fb@0];
	fb*.5;

	c#1*1;

!	Possible model alternatives:
!	fb with c#1*.5; ! this model is allowed

!	fb on c#1*.5; ! this model is allowed

!	c#1 on fb*.5; ! this model is not internally consistent 
				! (reciprocity problem) and is disallowed

	%c#1%
	[fb*2];

output:
	tech8 tech9;	