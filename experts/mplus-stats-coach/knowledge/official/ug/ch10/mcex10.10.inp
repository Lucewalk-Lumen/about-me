TITLE:	this is an example of a Monte Carlo simulation study for a 
        two-level GMM (three-level analysis)
        for a continuous outcome with a between-level
        categorical latent variable
montecarlo:
	names are y1-y4 x w;
	nobservations = 2000;
	ncsizes = 1;
	csizes = 100 (20);
	genclasses = cb(2 b) c(2);
	classes = cb(2) c(2);
	within = x;
	between = cb w;
	seed = 3457;
	nrep = 1;
	save = ex10.10.dat;

analysis:
	type = twolevel mixture;

model population:

	%within%

	%overall%
	[x@0]; x@1;

	[c#1*-0.5];
	c#1 on x*1;
	
	y1-y4*.25;
	iw sw | y1@0 y2@1 y3@2 y4@3;
	iw on x*1;
	sw on x*.7;
	iw*1; sw*.4;


	%between%

	%overall%

	[w@0]; w@1;

	ib sb | y1@0 y2@1 y3@2 y4@3;

	ib2 by y1-y4@1;

	y1-y4@0;

	ib on w*.6;
	sb on w*.3;
	c#1 on w*1;

	ib*.5; sb@0; c#1*1;
	ib with sb@0;

	ib2@0;
	ib2 with ib-sb@0;

	[cb#1*0];
	cb#1 on w*1.5;


model population-c:

	%between%

	%c#1%
	[ib*0 sb*.5];

	%c#2%
	[ib*3 sb*1];


Model population-cb:

	%between%

	%cb#1%
	[ib2@0];

	%cb#2%
	[ib2*2];



model:

	%within%

	%overall%


	[c#1*-0.5];
	c#1 on x*1;
	
	y1-y4*.25;
	iw sw | y1@0 y2@1 y3@2 y4@3;
	iw on x*1;
	sw on x*.7;
	iw*1; sw*.4;


	%between%

	%overall%



	ib sb | y1@0 y2@1 y3@2 y4@3;

	ib2 by y1-y4@1;

	y1-y4@0;

	ib on w*.6;
	sb on w*.3;
	c#1 on w*1;

	ib*.5; sb@0; c#1*1;
	ib with sb@0;

	ib2@0;
	ib2 with ib-sb@0;

	[cb#1*0];
	cb#1 on w*1.5;


model c:

	%between%

	%c#1%
	[ib*0 sb*.5];

	%c#2%
	[ib*3 sb*1];


Model cb:

	%between%

	%cb#1%
	[ib2@0];

	%cb#2%
	[ib2*2];



output:
	tech8 tech9;	