TITLE:	this is an example of a four-parameter 
    logistic item response theory (IRT) model 
	using priors for the lower (guessing) 
    and upper asymptote parameters
DATA:	FILE = ex5.5part4.dat;
VARIABLE:	NAMES = u1-u20;
	CATEGORICAL = u1-u20(4pl);
ANALYSIS:	ESTIMATOR = MLR;
MODEL:	f BY u1-u20*; 
	f@1;
	[u1$2-u20$2] (a1-a20);
	[u1$3-u20$3] (b1-b20);
OUTPUT:	TECH1 TECH8;
PLOT:	TYPE = PLOT3;
MODEL PRIORS:   
	a1-a20~N(1.386,1);
	b1-b20~N(-2,1);
