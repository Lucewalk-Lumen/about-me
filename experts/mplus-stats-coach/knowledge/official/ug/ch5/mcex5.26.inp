title: 
    this is an example of an EFA 
at two timepoints with factor loadings 
held equal and correlated residuals across time

montecarlo:
    names = y1-y12;
    nobs = 500;
    nreps = 1;
    save = ex5.26.dat;

model population:
    f1 by y1-y3*.8 y4-y6*0;
    f2 by y1-y3*0 y4-y6*.8;
    f3 by y7-y9*.8 y10-y12*0;
    f4 by y7-y9*0 y10-y12*.8;
    f1-f2@1;
    f1 with f2*.5;
    f3-f4*1;
    f3 with f4*.5;
    f3 with f1*.4 f2*.3;
    f4 with f1*.3 f2*.4;
    y1-y12*1;
    y1-y6 pwith y7-y12*.3;

model:
 f1 by y1-y3*.8 y4-y6*0 (*t1 1);
    f2 by y1-y3*0 y4-y6*.8 (*t1 1);
    f3 by y7-y9*.8 y10-y12*0 (*t2 1);
    f4 by y7-y9*0 y10-y12*.8 (*t2 1);
!    f1-f2@1;
    f1 with f2*.5;
!    f3-f4*1;
    f3 with f4*.5;
    f3 with f1*.4 f2*.3;
    f4 with f1*.3 f2*.4;
    y1-y12*1;
    y1-y6 pwith y7-y12*.3;

output: 
    tech9;