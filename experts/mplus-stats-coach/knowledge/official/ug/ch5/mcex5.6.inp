TITLE:	this is an example of a second-order factor analysis 

montecarlo:
	names = y1-y12;
	nobs = 500;
	nreps = 1;
	save = ex5.6.dat;

model population:
	
	f1 by y1@1 y2-y3*.7;
	f2 by y4@1 y5-y6*.7;
	f3 by y7@1 y8-y9*.7;
	f4 by y10@1 y11-y12*.7;

	y1-y12*.3;

	f5 by f1@1 f2-f4*1;	

	f1-f4*1;
	
	f5*.5;

model:	

	f1 by y1@1 y2-y3*.7;
	f2 by y4@1 y5-y6*.7;
	f3 by y7@1 y8-y9*.7;
	f4 by y10@1 y11-y12*.7;

	y1-y12*.3;

	f5 by f1@1 f2-f4*1;	

	f1-f4*1;
	
	f5*.5;
