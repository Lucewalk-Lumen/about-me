title: 
   	this is an example of an EFA with covariates (MIMIC) 
    with continuous factor indicators and direct effects
montecarlo:
    names = y1-y8 x1 x2;
    nobs = 500;
    nreps = 1;
    save = ex5.24.dat;
model population:
    [x1-x2@0]; x1-x2@1;
    f1 by y1-y5*.8 y6-y8*.01 (*1);
    f2 by y1-y3*.01 y4-y5*.2 y6-y8*.8(*1);
    y1-y8*.36; [y1-y8*0];
    f1-f2@1;
    f1 with f2*.5;
    f1 on x1*.5 x2*.2;
    f2 on x1*1 x2*.6;
    y1 on x1*.4;
    y8 on x2*.6;
model:
    f1 by y1-y5*.8 y6-y8*.01 (*1);
    f2 by y1-y3*.01 y4-y5*.2 y6-y8*.8(*1);
    y1-y8*.36; [y1-y8*0];
    f1 with f2*.5;
    f1 on x1*.5 x2*.2;
    f2 on x1*1 x2*.6;
    y1 on x1*.4;
    y8 on x2*.6;
output: 
    tech9;