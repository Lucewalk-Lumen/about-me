title:	this is an example of a CFA with continuous factor indicators 

montecarlo:
	names = y1-y6;
	nobs = 500;
	nreps = 1;
	save = ex5.20.dat;

model montecarlo:
    f1 by y1@1 y2-y3*1;
	f2 by y4@1 y5-y6*.8;
	y1-y3*.5; ! reliability 0.67
    y4-y6*.32; ! reliability 0.67
	f1-f2*1;

model:	
    f1 by y1
    y2-y3(lam2-lam3);
    f2 by y4 
    y5-y6*.8 (lam5-lam6);
    f1*1 (vf1);
    f2*1 (vf2);
    y1-y3*.5 (ve1-ve3); ! reliability 0.67
    y4-y6*.32 (ve4-ve6); ! reliability 0.67  

model constraint:
    new(rel2*.67 rel5*.67 stan3*.82 stan6*.82);
    rel2 = lam2**2*vf1/(lam2**2*vf1 + ve2); 
    rel5 = lam5**2*vf2/(lam5**2*vf2 + ve5); 
    rel5 = rel2;
    stan3 = lam3*sqrt(vf1)/sqrt(lam3**2*vf1 + ve3);
    stan6 = lam6*sqrt(vf2)/sqrt(lam6**2*vf2 + ve6);
    0 = stan6 - stan3;
    ve2 > ve5;
    ve4 > 0;

output:
	tech9;

