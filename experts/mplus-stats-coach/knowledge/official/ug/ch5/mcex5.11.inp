title:	this is an example of a SEM with 
	continuous factor indicators 

montecarlo:
	names = y1-y12;
	nobs = 500;
	nreps = 1;
	save = ex5.11.dat;

model montecarlo:

	f1 by y1@1 y2-y3*1;
	f2 by y4@1 y5-y6*.8;
	f3 by y7@1 y8-y9*.9;
	f4 by y10@1 y11-y12*.7;

	y1-y12*1;
	f1-f2*1;
	f3-f4*.5;

	f3 on f1*.5 f2*.7;
	f4 on f3*.6;

model:

	f1 by y1@1 y2-y3*1;
	f2 by y4@1 y5-y6*.8;
	f3 by y7@1 y8-y9*.9;
	f4 by y10@1 y11-y12*.7;

	y1-y12*1;
	f1-f2*1;
	f3-f4*.5;

	f3 on f1*.5 f2*.7;
	f4 on f3*.6;

output:
	tech9;


