title:	this is an example of a SEM with 
	EFA and CFA factors
montecarlo:
	names = y1-y12;
	nobs = 500;
	nreps = 1;
	save = ex5.25.dat;
model montecarlo:
	f1 by y1-y3*.8 y4-y6*.01 (*1);
    f2 by y1-y3*.01 y4-y6*.8(*1);
    y1-y6*.36; [y1-y6*0];
    f1-f2@1;
    f1 with f2*.5;
	f3 by y7@1 y8-y9*.9;
	f4 by y10@1 y11-y12*.7;
	y7-y12*.2;
	f3-f4*.5;
	f3 on f1*.5 f2*.7;
	f4 on f3*.6;

model:
    f1 by y1-y3*.8 y4-y6*.01 (*1);
    f2 by y1-y3*.01 y4-y6*.8(*1);
    y1-y6*.36; [y1-y6*0];
!    f1-f2@1;
    f1 with f2*.5;
	f3 by y7@1 y8-y9*.9;
	f4 by y10@1 y11-y12*.7;
	y7-y12*.2;
	f3-f4*.5;
	f3 on f1*.5 f2*.7;
	f4 on f3*.6;
output:
	tech9;


