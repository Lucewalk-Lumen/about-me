title:	this is an example of a threshold 
	structure CFA for categorical factor indicators

montecarlo:
	names = u1a u1b u1c u2a u2b u2c;
	generate = u1a-u2c(1);
	categorical = u1a-u2c;
	nobs = 500;
	nreps = 1;
	save = ex5.10.dat;

model population:

	f1 by u1a-u1c@1;
	f2 by u2a-u2c@1;
	[u1a$1*-.5 u1b$1*-.5 u1c$1*-.5] (1);	
	[u2a$1*.5 u2b$1*.5 u2c$1*.5] (2);

	u1a-u2c*.5; 

	f1-f2*.5; f1 with f2*.2;

	! note that u* variances should be 1
	! in order for the Delta parameterization
	! to give estimates in the correct metric


model:

	f1 by u1a-u1c@1;
	f2 by u2a-u2c@1;
	[u1a$1*-.5 u1b$1*-.5 u1c$1*-.5] (1);	
	[u2a$1*.5 u2b$1*.5 u2c$1*.5] (2);


	f1-f2*.5; f1 with f2*.2;

