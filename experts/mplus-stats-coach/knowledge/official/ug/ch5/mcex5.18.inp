title:	this is an example of a 2-group twin model 
	
montecarlo:
	names = y1 y2;
	ngroups = 2;
	nobs = 1000 1000;
	nreps = 1;
	save = ex5.18.dat;

model population:
    [y1-y2*0] (1);
    y1-y2@0;
    a1 BY y1*.8 (2);
    a2 BY y2*.8 (2);
    c1 BY y1*.3 (3);
    c2 BY y2*.3 (3);
    e1 BY y1*.52 (4);
    e2 BY y2*.52 (4);
    a1-e2@1;
    [a1-e2@0];
    a1 WITH a2@1; ! value for MZ twins
    c1 WITH c2@1;
    a1 WITH c1-e2@0;
    a2 WITH c1-e2@0;
    c1 WITH e1-e2@0;
    c2 WITH e1-e2@0;
    e1 WITH e2@0;
	
model population-g2: 
    a1 WITH a2@.5;  ! Value for DZ twins

model:
    [y1-y2*0] (1);
    y1-y2@0;
    a1 BY y1*.8 (2);
    a2 BY y2*.8 (2);
    c1 BY y1*.3 (3);
    c2 BY y2*.3 (3);
    e1 BY y1*.52 (4);
    e2 BY y2*.52 (4);
    a1-e2@1;
    [a1-e2@0];
    a1 WITH a2@1; ! value for MZ twins
    c1 WITH c2@1;
    a1 WITH c1-e2@0;
    a2 WITH c1-e2@0;
    c1 WITH e1-e2@0;
    c2 WITH e1-e2@0;
    e1 WITH e2@0;
		
model g2:
    a1 WITH a2@.5;  ! Value for DZ twins

output:
	tech9;

