TITLE:	this is an example of a mean structure CFA 
	for continuous factor indicators

montecarlo:
	names = y1a y1b y1c y2a y2b y2c;
	nobs = 500;
	nreps = 1;
	save = ex5.9.dat;

model population:
	
	f1 by y1a-y1c@1;
	f2 by y2a-y2c@1;
	[y1a*2 y1b*2 y1c*2] (1);	
	[y2a*3 y2b*3 y2c*3] (2);

	y1a-y2c*.5;

	f1-f2*1; f1 with f2*.5;

model:
	
	f1 by y1a-y1c@1;
	f2 by y2a-y2c@1;
	[y1a*2 y1b*2 y1c*2] (1);	
	[y2a*3 y2b*3 y2c*3] (2);

	y1a-y2c*.5;

	f1-f2*1; f1 with f2*.5;

output:
	tech9;