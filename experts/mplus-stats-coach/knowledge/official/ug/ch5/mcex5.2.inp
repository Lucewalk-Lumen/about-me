TITLE:	this is an example of a CFA with categorical factor indicators

montecarlo:
	names = u1-u6;
	generate = u1-u6(1);
	categorical = u1-u6;
	nobs = 500;
	nreps = 1;
	save = ex5.2.dat;

model montecarlo:

	f1 by u1@1 u2-u3*1;
	f2 by u4@1 u5-u6*1;
	u1-u6*.2;
	f1-f2*.8;

	! note that u* variances should be 1
	! in order for the Delta parameterization
	! to give estimates in the correct metric

model:	
	f1 by u1@1 u2-u3*1;
	f2 by u4@1 u5-u6*1;

	f1-f2*.8;

output:
	tech9;

