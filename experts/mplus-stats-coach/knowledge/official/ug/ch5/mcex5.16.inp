title:	this is an example of a multiple group CFA 
	with covariates (MIMIC) with categorical 
	factor indicators and a threshold structure

montecarlo:
	names = u1-u6 x1-x3;
	generate = u1-u6(1);
	categorical = u1-u6;
	ngroups = 2;
	nobs = 1000 1200;
	nreps = 1;
	save = ex5.16.dat;

model population:

	[x1-x3@0]; x1-x3@1;
	
	f1 by u1@1 u2-u3*1;
	f2 by u4@1 u5-u6*1;
	f1 on x1*.5 x2*.6 x3*.7;
	f2 on x1*.7 x2*.6 x3*.5;

	f1-f2*.7;
	f1 with f2*0;
	
	u1-u6*.3;

	! note that u* variances should be 1
	! in order for the Delta parameterization
	! to give estimates in the correct metric

	[u1$1*-1];
	[u2$1*-.5];
	[u3$1*-.25];
	[u4$1*0];
	[u5$1*.25];
	[u6$1*.5];

	
model population-g2:

	f1 by u3*.5;
	[u3$1*.5];
	u3*.6; !modified so that u3* variance is 1


model:


	f1 by u1@1 u2-u3*1;
	f2 by u4@1 u5-u6*1;
	f1 on x1*.5 x2*.6 x3*.7;
	f2 on x1*.7 x2*.6 x3*.5;

	f1-f2*.7;
	f1 with f2*0;

	[u1$1*-1];
	[u2$1*-.5];
	[u3$1*-.25];
	[u4$1*0];
	[u5$1*.25];
	[u6$1*.5];



	
model g2:

	f1 by u3*.5;
	[u3$1*.5];
	{u3@1};

output:
	tech9;
