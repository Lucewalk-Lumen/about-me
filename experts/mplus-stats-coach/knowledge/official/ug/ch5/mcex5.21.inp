title:	this is an example of a 2-group twin model 
	
montecarlo:
	names = y1 y2;
	ngroups = 2;
	nobs = 1000 1000;
	nreps = 1;
	save = ex5.21.dat;

model population:
    [y1-y2*0];
    y1-y2*1;
    y1 WITH y2*0.73; ! Value for MZ twins
	
model population-g2: 
	y1 WITH y2*0.41;  ! Value for DZ twins

model:
    [y1-y2*0] (1);
    y1-y2*1 (var);
    y1 WITH y2*0.73(covmz);
		
model g2:
    y1 WITH y2*0.41(covdz);

model constraint:
    NEW(a*.8 c*.3 e*.52 h*.64);
    var = a**2 + c**2 + e**2;
    covmz = a**2 + c**2;
    covdz = 0.5*a**2 + c**2;
    h = a**2/(a**2 + c**2 + e**2);

output:
	tech9;

