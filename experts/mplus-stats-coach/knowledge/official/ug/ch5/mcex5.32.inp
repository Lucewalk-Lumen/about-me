TITLE: this is an example of BSEM analysis of a MIMIC model
    with cross-loadings and direct effects
    (same data generation as for ex5.8)
MONTECARLO:
    NAMES = y1-y6 x1-x3;
	NOBSERVATIONS = 500;
	NREPS = 1;
	save = ex5.32.dat;

MODEL POPULATION:

	[x1@0 x2@1 x3@2]; x1@3 x2@2 x3@1;
	
	f1 by y1@1 y2-y3*1;
	f2 by y4@1 y5-y6*1;
	f1 on x1*.5 x2*.6 x3*.7;
	f2 on x1*.7 x2*.6 x3*.5;

	f1-f2*.7;
	f1 with f2*.25;
	
	y1-y6*.5;

MODEL:	

	f1 by y1@1 y2-y3*1;
	f2 by y4@1 y5-y6*1;
	f1 on x1*.5 x2*.6 x3*.7;
	f2 on x1*.7 x2*.6 x3*.5;

	f1-f2*.7;
	f1 with f2*.25;
	
	y1-y6*.5;
	
OUTPUT:
	TECH9;	