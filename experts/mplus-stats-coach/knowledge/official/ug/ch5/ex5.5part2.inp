TITLE:          this is an example of a two-parameter logistic 
                item response theory (IRT) model
DATA:           FILE = ex5.5part2.dat;
VARIABLE:       NAMES ARE u1-u20;
                CATEGORICAL ARE u1-u20;
ANALYSIS:       ESTIMATOR = MLR;
MODEL:          f BY u1-u20*; 
                f@1;
OUTPUT:	        TECH1 TECH8; 
PLOT:           TYPE = PLOT3;