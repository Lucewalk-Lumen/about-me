TITLE:	this is an example of a CFA with continuous 
	and categorical factor indicators 

montecarlo:
	names = u1-u3 y4-y6;
	generate = u1-u3(1);
	categorical = u1-u3;
	nobs = 500;
	nreps = 1;
	save = ex5.3.dat;

model montecarlo:

	f1 by u1@1 u2-u3*1;
	f2 by y4@1 y5-y6*1;
	u1-y6*.2;
	f1-f2*.8;

	! note that u* variances should be 1
	! in order for the Delta parameterization
	! to give estimates in the correct metric

model:	
	f1 by u1@1 u2-u3*1;
	f2 by y4@1 y5-y6*1;
	y5-y6*.2;
	f1-f2*.8;

output:
	tech9;

