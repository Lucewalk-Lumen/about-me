TITLE: this is an example of BSEM analysis of a 
    multiple-group model with approximate
    measurement invariance (figure is ex 5.1)
MONTECARLO:
    NAMES = y1-y6 u;
    GENERATE =  u (9);
    CATEGORICAL  = u;
    GENCLASSES = c(10);
    CLASSES = c(10);
	NOBSERVATIONS = 2000;
	NREPS = 1;
    SAVE = ex5.33.dat;

MODEL POPULATION:
    %OVERALL%
	f1 BY y1-y3*1; 
	f2 BY y4-y6*1; 
    [y1-y6*0];
    [f1-f2*1];
	f1-f2*2;
	f1 WITH f2*.25;	
	y1-y6*.5;
    %c#1%
    [u$1@15 u$2@16 u$3@17 u$4@18 u$5@19 u$6@20 u$7@21 u$8@22 u$9@23];
    f1 BY y1-y3*1 (lam1_1-lam1_3);
	f2 BY y4-y6*1 (lam1_4-lam1_6);
    [y1-y6*0] (nu1_1-nu1_6);
    [f1-f2*1];
	f1-f2*2;
	f1 WITH f2*.25;	
    %c#2%
    [u$1@-15 u$2@16 u$3@17 u$4@18 u$5@19 u$6@20 u$7@21 u$8@22 u$9@23];
    f1 BY y1*1.1 y2-y3*1 (lam2_1-lam2_3);;
	f2 BY y4-y6*1 (lam2_4-lam2_6);
    [y1-y5*0 y6*0.1] (nu2_1-nu2_6);
    [f1-f2*1];
	f1-f2*1.8;
    f1 WITH f2*.20;
    %c#3%
    [u$1@-16 u$2@-15 u$3@17 u$4@18 u$5@19 u$6@20 u$7@21 u$8@22 u$9@23];
    f1 BY y1*1 y2*1.1 y3*1 (lam3_1-lam3_3);
	f2 BY y4-y6*1 (lam3_4-lam3_6);
    [y1-y4*0 y5*0.1 y6*0] (nu3_1-nu3_6);
    [f1-f2*0.6];
	f1-f2*1.6;
    f1 WITH f2*.15;
    %c#4%
    [u$1@-17 u$2@-16 u$3@-15 u$4@18 u$5@19 u$6@20 u$7@21 u$8@22 u$9@23];
    f1 BY y1-y2*1 y3*1.1 (lam4_1-lam4_3);
	f2 BY y4-y6*1 (lam4_4-lam4_6);
    [y1-y3*0 y4*0.1 y5-y6*0] (nu4_1-nu4_6);
    [f1-f2*0.4];
	f1-f2*1.4;
    f1 WITH f2*.10;
    %c#5%
    [u$1@-18 u$2@-17 u$3@-16 u$4@-15 u$5@19 u$6@20 u$7@21 u$8@22 u$9@23];
    f1 BY y1-y3*1 (lam5_1-lam5_3);
	f2 BY y4*1.1 y5-y6*1 (lam5_4-lam5_6);
    [y1-y2*0 y3*0.1 y4-y6*0] (nu5_1-nu5_6);
    [f1-f2*0]; 
	f1-f2*1; 
    f1 WITH f2*.05;
    %c#6%
    [u$1@-18 u$2@-17 u$3@-16 u$4@-15 u$5@-14 u$6@20 u$7@21 u$8@22 u$9@23];
    f1 BY y1-y3*1 (lam6_1-lam6_3);
	f2 BY y4-y6*1 (lam6_4-lam6_6);
    [y1-y6*0] (nu6_1-nu6_6);
    [f1-f2*1];
	f1-f2*2;
	f1 WITH f2*.25;	
    %c#7%
    [u$1@-18 u$2@-17 u$3@-16 u$4@-15 u$5@-14 u$6@-13 u$7@21 u$8@22 u$9@23];
    f1 BY y1*1.1 y2-y3*1 (lam7_1-lam7_3);
	f2 BY y4-y6*1 (lam7_4-lam7_6);
    [y1-y5*0 y6*0.1] (nu7_1-nu7_6);
    [f1-f2*1];
	f1-f2*1.8;
    f1 WITH f2*.20;
    %c#8%
    [u$1@-18 u$2@-17 u$3@-16 u$4@-15 u$5@-14 u$6@-13 u$7@-12 u$8@22 u$9@23];
    f1 BY y1*1 y2*1.1 y3*1 (lam8_1-lam8_3);
	f2 BY y4-y6*1 (lam8_4-lam8_6);
    [y1-y4*0 y5*0.1 y6*0] (nu8_1-nu8_6);
    [f1-f2*0.6];
	f1-f2*1.6;
    f1 WITH f2*.15;
    %c#9%
    [u$1@-18 u$2@-17 u$3@-16 u$4@-15 u$5@-14 u$6@-13 u$7@-12 u$8@-11 u$9@23];
    f1 BY y1-y2*1 y3*1.1 (lam9_1-lam9_3);
	f2 BY y4-y6*1 (lam9_4-lam9_6);
    [y1-y3*0 y4*0.1 y5-y6*0] (nu9_1-nu9_6);
    [f1-f2*0.4];
	f1-f2*1.4;
    f1 WITH f2*.10;
    %c#10%
    [u$1@-18 u$2@-17 u$3@-16 u$4@-15 u$5@-14 u$6@-13 u$7@-12 u$8@-11 u$9@-10];
    f1 BY y1-y3*1 (lam10_1-lam10_3);
	f2 BY y4*1.1 y5-y6*1 (lam10_4-lam10_6);
    [y1-y2*0 y3*0.1 y4-y6*0] (nu10_1-nu10_6);
    [f1-f2*0]; 
	f1-f2*1; 
    f1 WITH f2*.05;

ANALYSIS:
    TYPE =MIXTURE;
    ESTIMATOR = BAYES;
    PROCESSORS = 2;

MODEL:
    %OVERALL%
	f1 BY y1-y3*1; 
	f2 BY y4-y6*1; 
    [y1-y6*0];
    [f1-f2*1];
	f1-f2*2;
	f1 WITH f2*.25;	
	y1-y6*.5;
    %c#1%
    [u$1@15 u$2@16 u$3@17 u$4@18 u$5@19 u$6@20 u$7@21 u$8@22 u$9@23];
    f1 BY y1-y3*1 (lam1_1-lam1_3);
	f2 BY y4-y6*1 (lam1_4-lam1_6);
    [y1-y6*0] (nu1_1-nu1_6);
    [f1-f2*1];
	f1-f2*2;
	f1 WITH f2*.25;	
	y1-y6*.5;
    %c#2%
    [u$1@-15 u$2@16 u$3@17 u$4@18 u$5@19 u$6@20 u$7@21 u$8@22 u$9@23];
    f1 BY y1*1.1 y2-y3*1 (lam2_1-lam2_3);;
	f2 BY y4-y6*1 (lam2_4-lam2_6);
    [y1-y5*0 y6*0.1] (nu2_1-nu2_6);
    [f1-f2*1];
	f1-f2*1.8;
    f1 WITH f2*.20;
	y1-y6*.5;
    %c#3%
    [u$1@-16 u$2@-15 u$3@17 u$4@18 u$5@19 u$6@20 u$7@21 u$8@22 u$9@23];
    f1 BY y1*1 y2*1.1 y3*1 (lam3_1-lam3_3);
	f2 BY y4-y6*1 (lam3_4-lam3_6);
    [y1-y4*0 y5*0.1 y6*0] (nu3_1-nu3_6);
    [f1-f2*0.6];
	f1-f2*1.6;
    f1 WITH f2*.15;
	y1-y6*.5;
    %c#4%
    [u$1@-17 u$2@-16 u$3@-15 u$4@18 u$5@19 u$6@20 u$7@21 u$8@22 u$9@23];
    f1 BY y1-y2*1 y3*1.1 (lam4_1-lam4_3);
	f2 BY y4-y6*1 (lam4_4-lam4_6);
    [y1-y3*0 y4*0.1 y5-y6*0] (nu4_1-nu4_6);
    [f1-f2*0.4];
	f1-f2*1.4;
    f1 WITH f2*.10;
	y1-y6*.5;
    %c#5%
    [u$1@-18 u$2@-17 u$3@-16 u$4@-15 u$5@19 u$6@20 u$7@21 u$8@22 u$9@23];
    f1 BY y1-y3*1 (lam5_1-lam5_3);
	f2 BY y4*1.1 y5-y6*1 (lam5_4-lam5_6);
    [y1-y2*0 y3*0.1 y4-y6*0] (nu5_1-nu5_6);
    [f1-f2*0]; 
	f1-f2*1; 
    f1 WITH f2*.05;
	y1-y6*.5;
    %c#6%
    [u$1@-18 u$2@-17 u$3@-16 u$4@-15 u$5@-14 u$6@20 u$7@21 u$8@22 u$9@23];
    f1 BY y1-y3*1 (lam6_1-lam6_3);
	f2 BY y4-y6*1 (lam6_4-lam6_6);
    [y1-y6*0] (nu6_1-nu6_6);
    [f1-f2*1];
	f1-f2*2;
	f1 WITH f2*.25;	
	y1-y6*.5;
    %c#7%
    [u$1@-18 u$2@-17 u$3@-16 u$4@-15 u$5@-14 u$6@-13 u$7@21 u$8@22 u$9@23];
    f1 BY y1*1.1 y2-y3*1 (lam7_1-lam7_3);
	f2 BY y4-y6*1 (lam7_4-lam7_6);
    [y1-y5*0 y6*0.1] (nu7_1-nu7_6);
    [f1-f2*1];
	f1-f2*1.8;
    f1 WITH f2*.20;
	y1-y6*.5;
    %c#8%
    [u$1@-18 u$2@-17 u$3@-16 u$4@-15 u$5@-14 u$6@-13 u$7@-12 u$8@22 u$9@23];
    f1 BY y1*1 y2*1.1 y3*1 (lam8_1-lam8_3);
	f2 BY y4-y6*1 (lam8_4-lam8_6);
    [y1-y4*0 y5*0.1 y6*0] (nu8_1-nu8_6);
    [f1-f2*0.6];
	f1-f2*1.6;
    f1 WITH f2*.15;
	y1-y6*.5;
    %c#9%
    [u$1@-18 u$2@-17 u$3@-16 u$4@-15 u$5@-14 u$6@-13 u$7@-12 u$8@-11 u$9@23];
    f1 BY y1-y2*1 y3*1.1 (lam9_1-lam9_3);
	f2 BY y4-y6*1 (lam9_4-lam9_6);
    [y1-y3*0 y4*0.1 y5-y6*0] (nu9_1-nu9_6);
    [f1-f2*0.4];
	f1-f2*1.4;
    f1 WITH f2*.10;
	y1-y6*.5;
    %c#10%
    [u$1@-18 u$2@-17 u$3@-16 u$4@-15 u$5@-14 u$6@-13 u$7@-12 u$8@-11 u$9@-10];
    f1 BY y1-y3*1 (lam10_1-lam10_3);
	f2 BY y4*1.1 y5-y6*1 (lam10_4-lam10_6);
    [y1-y2*0 y3*0.1 y4-y6*0] (nu10_1-nu10_6);
    [f1-f2@0]; 
	f1-f2@1; 
    f1 WITH f2*.05;
	y1-y6*.5;
   
MODEL PRIORS:
    DO(1,6) DIFF(lam1_#-lam10_#)~N(0,0.01);
    DO(1,6) DIFF(nu1_#-nu10_#)~N(0,0.01);
	
OUTPUT:
	TECH8 TECH9;	