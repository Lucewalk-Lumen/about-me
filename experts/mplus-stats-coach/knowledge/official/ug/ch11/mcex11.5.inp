TITLE:	this is an example of a Monte Carlo 
	simulation study with missing data
    where missing on y is a function of z 
MONTECARLO:
	NAMES ARE x1 x2 y1-y4 z1-z5 v1-v50;
	NOBSERVATIONS = 500;
	NREPS = 1;
    GENERATE = x1(1);
	CATEGORICAL = x1; 
	MISSING = x1-x2 y1-y4;
    SAVE = ex11.5.dat;
MODEL POPULATION:
    x1-y4 ON z1-z5*.5;
	x2*1 y1-v50*1;
	[x1$1*0 x2-v50*0];	
MODEL MISSING:
	[x1-y4@-1];
	y1 ON z1*.4 z2*.2;
	y2 ON z3*.8 z4*.4;
	y3 ON z1*1.6 z5*.8;
	y4 ON z2*3.2 z3*1.6;
ANALYSIS:
    ESTIMATOR = ML;
MODEL:
    x1-y4 ON z1-z5*.5;
	x2*1 y1-v50*1;
	[x1$1*0 x2-v50*0];   
OUTPUT:	TECH9;
