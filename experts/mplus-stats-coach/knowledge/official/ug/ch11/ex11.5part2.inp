TITLE:	this is an example of growth modeling 
		using multiple imputation data 
DATA:		FILE = ex11.5implist.dat;
		TYPE = IMPUTATION;
VARIABLE:	NAMES = x1 y1-y4 z x2;
		USEVARIABLES = y1-y4 x1 x2;
ANALYSIS:	ESTIMATOR = ML;
MODEL:	i s | y1@0 y2@1 y3@2 y4@3;
		i s ON x1 x2;
OUTPUT:	TECH1 TECH4;
