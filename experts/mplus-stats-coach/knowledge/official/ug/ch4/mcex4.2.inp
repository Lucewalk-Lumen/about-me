title:	this is an example of a CFA with categorical
		 factor indicators 

montecarlo:
	names = u1-u12;
	generate = u1-u12(1);
	categorical = u1-u12;
	nobs = 500;
	nreps = 1;
	save = ex4.2.dat;

model population:
	f1 by u1-u3*.7;
	f2 by u4-u6*.7;
	f3 by u7-u9*.7;
	f4 by u10-u12*.7;
	u1-u12*.51;
	!V*u*) = 1 so that the parameter metric matches
	!that of the Delta parameterization
	f1-f4@1;

model:	
	f1 by u1-u3*.7;
	f2 by u4-u6*.7;
	f3 by u7-u9*.7;
	f4 by u10-u12*.7;
	
	f1-f4@1;

output:
	tech9;

