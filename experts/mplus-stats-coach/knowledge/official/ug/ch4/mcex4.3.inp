title:	this is an example of a CFA with continuous,
    censored, categorical, and count factor indicators 

montecarlo:
	names = y1-y6 u1-u6;
	generate = y4-y6(cb 0) u1-u3(1) u4-u6(c);
    censored = y4-y6(b);
    categorical = u1-u3;
    count = u4-u6;
	nobs = 500;
	nreps = 1;
	save = ex4.3.dat;

model population:
	f1 by y1-y3*.7;
	f2 by y4-y6*.7;
	f3 by u1-u3*.7;
	f4 by u4-u6*.7;
	y1-y6*.51;
	f1-f4@1;

analysis:
    estimator = mlr;
    integration = 7;

model:	
	f1 by y1-y3*.7;
	f2 by y4-y6*.7;
	f3 by u1-u3*.7;
	f4 by u4-u6*.7;
	y1-y6*.51;
	f1-f4@1;

output:
	tech9;

