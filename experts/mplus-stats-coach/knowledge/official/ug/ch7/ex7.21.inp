TITLE:	this is an example of mixture modeling
	with known classes (multiple group 
	analysis)
DATA:	FILE IS ex7.21.dat;
VARIABLE:	NAMES = g y1-y4;
	CLASSES = cg (2) c (2);
	KNOWNCLASS = cg (g = 0 g = 1);
ANALYSIS:	TYPE = MIXTURE;
MODEL:
	%OVERALL%
	c ON cg;
MODEL c:
	%c#1%
	[y1-y4];
	%c#2%
	[y1-y4];
MODEL cg:
	%cg#1%
	y1-y4;
	%cg#2%
	y1-y4;
OUTPUT:	TECH1 TECH8;



