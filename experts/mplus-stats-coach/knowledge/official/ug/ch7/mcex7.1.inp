title:
	this is an example of a mixture regression 
	analysis for a continuous dependent 
	variable using automatic starting values 
	with random starts

montecarlo:
	names are y x1 x2;
	genclasses = c(2);
	classes = c(2);
	nobs = 500;
	seed = 3454367;
	nrep = 1;
	save = ex7.1.dat;

analysis:
	type = mixture;

model population:

	%overall%

	x1-x2*1; 
	[x1-x2*0];


	[c#1*0];

	c#1 on x1*1;

	y on x1*2 x2*1;
	
	[y*1]; y*1;
	
	%c#1%

	y on x2*2;
	[y*2];
	y*2;

model:

	%overall%


	[c#1*0];

	c#1 on x1*1;

	y on x1*2 x2*1;
	
	[y*1]; y*1;
	
	%c#1%

	y on x2*2;
	[y*2];
	y*2;

output:
	tech8 tech9;
	
	
	

	
	