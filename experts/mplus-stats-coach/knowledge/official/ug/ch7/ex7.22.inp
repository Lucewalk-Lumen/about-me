TITLE:	this is an example of mixture modeling
	with continuous variables that correlate
	within class
DATA:	FILE IS ex7.22.dat;
VARIABLE:	NAMES ARE y1-y4 c;
	USEVARIABLES ARE y1-y4;
	CLASSES = c (3);
ANALYSIS:	TYPE = MIXTURE;
MODEL:	
	%OVERALL%
	y1 WITH y2-y4;
	y2 WITH y3 y4;
	y3 WITH y4;
	%c#2%
	[y1-y4*-1];
	%c#3%
	[y1-y4*1];
OUTPUT:	TECH1 TECH8;
