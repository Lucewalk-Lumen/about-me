TITLE:	this is an example of a LCA with binary latent class indicators and
        parameter constraints
DATA:	FILE IS ex7.13.dat;
VARIABLE:	NAMES ARE u1-u4;
	CLASSES = c (2);
	CATEGORICAL = u1-u4;
ANALYSIS:	TYPE = MIXTURE;
MODEL:
	%OVERALL%
	%c#1%
	[u1$1*-1];
	[u2$1-u3$1*-1] (1);
	[u4$1*-1] (p1);
	%c#2%
	[u1$1@-15];
	[u2$1-u3$1*1] (2);
	[u4$1*1] (p2);
MODEL CONSTRAINT:
	p2 = - p1;
OUTPUT:	TECH1 TECH8;
