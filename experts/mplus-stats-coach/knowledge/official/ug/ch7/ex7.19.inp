TITLE:	this is an example of a SEM with a categorical latent variable 
regressed on a continuous latent variable
DATA: 	FILE IS ex7.19.dat;
VARIABLE:	NAMES ARE u1-u8;
	CATEGORICAL = u1-u8;
	CLASSES = c (2);
ANALYSIS:	TYPE = MIXTURE;	
	ALGORITHM = INTEGRATION;
MODEL:	
	%OVERALL%
	f BY u1-u4;
	c ON f;
	%c#1%
	[u5$1-u8$1];
	%c#2%
	[u5$1-u8$1];
OUTPUT:	TECH1 TECH8;

