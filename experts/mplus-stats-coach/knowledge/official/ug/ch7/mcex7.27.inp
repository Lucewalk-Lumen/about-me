title:
	this is an example of a factor mixture analysis
    with binary latent class indicators 

montecarlo:
	names are u1-u8;
	generate = u1-u8(1);
	categorical = u1-u8;
	genclasses = c(2);
	classes = c(2);
	nobs = 2000;
	seed = 3454367;
	nrep = 1;
	save = ex7.27.dat;

model population:

	%overall%

    f by u1@1 u2-u8*1;
    [f@0];

	[c#1*0];
	
	%c#1%
    f by u2-u4*1 u5-u8*.5;
    f*3;
	[u1$1*2 u2$1*2 u3$1*2 u4$1*2 u5$1*-2 u6$1*-2 u7$1*-2 u8$1*-2];

	%c#2%
    f by u2-u4*.5 u5-u8*1;
    f*2;
	[u1$1*-2 u2$1*-2 u3$1*-2 u4$1*-2 u5$1*2 u6$1*2 u7$1*2 u8$1*2];

analysis:
	type = mixture;
    algorithm = integration;
 !   estimator = mlf;
  !  adaptive = off;

model:
    %overall%

    f by u1@1 u2-u8*1;
    [f@0];

	[c#1*0];
	
	%c#1%
    f by u2-u4*1 u5-u8*.5;
    f*3;
	[u1$1*2 u2$1*2 u3$1*2 u4$1*2 u5$1*-2 u6$1*-2 u7$1*-2 u8$1*-2];

	%c#2%
    f by u2-u4*.5 u5-u8*1;
    f*2;
	[u1$1*-2 u2$1*-2 u3$1*-2 u4$1*-2 u5$1*2 u6$1*2 u7$1*2 u8$1*2];

output:
	tech8 tech9;
	
	
	

	
	