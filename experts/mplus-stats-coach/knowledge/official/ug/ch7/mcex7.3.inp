title:
	this is an example of a LCA with binary 
	latent class indicators using automatic 
	starting values with random starts

montecarlo:
	NAMES = u1-u4 x1-x10;
	generate = u1-u4(1);
	categorical = u1-u4;
	genclasses = c(2);
	classes = c(2);
	nobs = 500;
	seed = 3454367;
	nrep = 1;
	save = ex7.3.dat;

analysis:
	type = mixture;

model population:

	%overall%

	[c#1*1];
    x1-x10*1;
	
	%c#1%
	[u1$1*2 u2$1*2 u3$1*-2 u4$1*-2];
    [x1-x2*-2 x3-x4*-1 x5-x6*0 x7-x8*1 x9-x10*2];

	%c#2%
	[u1$1*-2 u2$1*-2 u3$1*2 u4$1*2];
    [x1-x2*2 x3-x4*1 x5-x6*0 x7-x8*-1 x9-x10*-2];

model:

    %overall%

	[c#1*1];
    x1-x10*1;
	
	%c#1%
	[u1$1*2 u2$1*2 u3$1*-2 u4$1*-2];
    [x1-x2*-2 x3-x4*-1 x5-x6*0 x7-x8*1 x9-x10*2];

	%c#2%
	[u1$1*-2 u2$1*-2 u3$1*2 u4$1*2];
    [x1-x2*2 x3-x4*1 x5-x6*0 x7-x8*-1 x9-x10*-2];
output:
	tech8 tech9;	
	