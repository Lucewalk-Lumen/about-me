title:
	this is an example of CFA with a non-parametric
	representation of a non-normal factor
montecarlo:
	names are y1-y5;
	genclasses = c(3);
	classes = c(3);
	nobs = 500;
	seed = 3454367;
	nrep = 1;
	save = ex7.26.dat;

analysis:
	type = mixture;

model population:

	%overall%

	y1-y5*.25;
	f by y1@1 y2-y5*.75;
	[f@0];
	f@0;

	[c#1*-2.5 c#2*-1.5];
	
	%c#1%
	[f*4];

	%c#2%
	[f*2];

model:
	
	%overall%
	%overall%

	y1-y5*.25;
	f by y1@1 y2-y5*.75;
	[f@0];
	f@0;

	[c#1*-2.5 c#2*-1.5];
	
	%c#1%
	[f*4];

	%c#2%
	[f*2];

output:
	tech8 tech9;	
	