title:	this is an example of a mixture regression 
	analysis for a count variable using a 
	zero-inflated Poisson model using 
	automatic starting values with random 
	starts

montecarlo:			
	names = u x1 x2;
	seed = 53487;
	nobs = 500;
	nreps = 1;
	generate = u(ci);
	count = u(i);
	genclasses = c(2);
	classes = c(2);
	save = ex7.2.dat;

analysis:
	type = mixture;
	
model population:
	
	%overall%
	
	[x1-x2@0];
	x1-x2@1;

	u on x1*.5 x2*.3;
	[u*1];
	u#1 on x1*2 x2*1;
	[u#1*-1] ; 

	c#1 on x1*1;

	%c#1%
	[u*2];
	u on x2*0;

model:

	%overall%

	u on x1*.5 x2*.3;
	[u*1];
	u#1 on x1*2 x2*1;
	[u#1*-1] (1); 

	c#1 on x1*1;

	%c#1%
	[u*2];
	u on x2*0;
	

output:
	tech8;
