TITLE:	this is an example of a LCA with a second-order factor (twin analysis)	
DATA:	FILE IS ex7.18.dat;
VARIABLE:	NAMES ARE u11-u13 u21-u23;
	CLASSES = c1(2) c2(2);
	CATEGORICAL = u11-u23;
ANALYSIS:	TYPE = MIXTURE;
	ALGORITHM = INTEGRATION;
MODEL:
	%OVERALL%
	f BY;
	f@1;
	c1 c2 ON f*1 (1);
MODEL c1:
	%c1#1%
	[u11$1-u13$1*-1];
	%c1#2%
	[u11$1-u13$1*1];
MODEL c2:
	%c2#1%
	[u21$1-u23$1*-1];
	%c2#2%
	[u21$1-u23$1*1];
OUTPUT:	TECH1 TECH8;
