TITLE:	this is an example of a Monte Carlo
          simulation study for a two-level
          continuous-time survival analysis using
          Cox regression with a random intercept and
          a frailty
MONTECARLO:
	NAMES = t x w;
	NOBSERVATIONS = 1000;
	NREPS = 100;
	GENERATE = t(s 20*1);
	NCSIZES = 3;
	CSIZES = 40 (5) 50 (10) 20 (15);
	HAZARDC = t (.5);
	SURVIVAL = t (ALL);  
	WITHIN = x;
	BETWEEN = w;
MODEL POPULATION:
	%WITHIN%
	x@1;
	t ON x*.5;
	%BETWEEN%
	w@1;
	[t#1-t#21*1];
	t ON w*.2;
	t*0.5;
ANALYSIS:	TYPE = TWOLEVEL;
	BASEHAZARD = OFF;
MODEL:	%WITHIN%
	t ON x*.5;
	%BETWEEN%
	t ON w*.2;
	t*0.5;
