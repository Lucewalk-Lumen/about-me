TITLE:	this is an example of a Monte Carlo
	simulation study for a growth mixture
	model with two classes and a misspecified
	model
MONTECARLO:
	NAMES ARE u y1-y4 x;
	NOBSERVATIONS = 500;
	NREPS = 10;
	SEED = 53487;
	GENERATE = u (1);
	CATEGORICAL = u;
	GENCLASSES = c (2);
	CLASSES = c (1);
MODEL POPULATION:
	%OVERALL%
	[x@0];
	x@1;
	i s | y1@0 y2@1 y3@2 y4@3;
	i*.25 s*.04;
	i WITH s*0;
	y1*.4 y2*.35 y3*.3 y4*.25;
	i ON x*.5;
	s ON x*.1;
	c#1 ON x*.2;
	[c#1*0];
	%c#1%
	[u$1*1 i*3 s*.5];
	%c#2%
	[u$1*-1 i*1 s*0];
ANALYSIS:	TYPE = MIXTURE;
MODEL:
	%OVERALL%	
	i s | y1@0 y2@1 y3@2 y4@3;
	i*.25 s*.04;
	i WITH s*0;
	y1*.4 y2*.35 y3*.3 y4*.25;
	i ON x*.5;
	s ON x*.1;
!	c#1 ON x*.2;
!	[c#1*0];
	u ON x;
	%c#1%
	[u$1*1 i*3 s*.5];
!	%c#2%
!	[u$1*-1 i*1 s*0];
OUTPUT:	TECH9;
