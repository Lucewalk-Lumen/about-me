TITLE:	this is an example of a Monte Carlo 
simulation study for a multiple-group EFA 
with continuous factor indicators with 
measurement invariance of intercepts and factor loadings
MONTECARLO:
	NAMES ARE y1-y10;
	NOBSERVATIONS = 500 500;
	NREPS = 1;
	NGROUPS = 2;
MODEL POPULATION:
	f1 BY y1-y5*.8 y6-y10*0;
	f2 BY y1-y5*0 y6-y10*.8;
	f1-f2@1;
	f1 WITH f2*.5;
	y1-y10*1;
	[y1-y10*1];
	[f1-f2@0];
MODEL POPULATION-g2:
	f1*1.5 f2*2;
	f1 WITH f2*1;
	y1-y10*2;
	[f1*.5 f2*.8];
MODEL:	f1 BY y1-y5*.8 y6-y10*0 (*1);
	f2 BY y1-y5*0 y6-y10*.8 (*1);
	f1-f2@1;
	f1 WITH f2*.5;
	y1-y10*1;
	[y1-y10*1] (1-10);
	[f1-f2@0];
MODEL g2:	f1*1.5 f2*2;
	f1 WITH f2*1;
	y1-y10*2;
	[f1*.5 f2*.8];
OUTPUT:	TECH9;
