TITLE:	this is an example of a Monte Carlo 
simulation study for discrete-time survival 
analysis
MONTECARLO:
	NAMES = u1-u4 x;
	NOBSERVATIONS = 1000;
	NREPS = 100;
	GENERATE = u1-u4(1);
	MISSING = u2-u4;
	CATEGORICAL = u1-u4;
MODEL POPULATION:
	[x@0]; x@1;
	[u1$1*2 u2$1*1.5 u3$1*1 u4$1*1];
	f BY u1-u4@1;
	f ON x*.5;
    f@0;	
MODEL MISSING:	
	[u2-u4@-15];
	u2 ON u1@30;
	u3 ON u1-u2@30;
	u4 ON u1-u3@30;
ANALYSIS:	ESTIMATOR = MLR;
MODEL:	[u1$1*2 u2$1*1.5 u3$1*1 u4$1*1];
	f BY u1-u4@1;
	f ON x*.5;
    f@0;
OUTPUT:	TECH8 TECH9;
