TITLE:
    GMM skeleton - growth mixture model, four waves (self-authored)

DATA:
    FILE IS mydata.dat;

VARIABLE:
    NAMES ARE id y1-y4 x1 x2;
    USEVARIABLES = y1-y4 x1 x2;
    CLASSES = c (2);
    MISSING = ALL (-999);

ANALYSIS:
    TYPE = MIXTURE;
    ESTIMATOR = MLR;
    STARTS = 800 200;
    PROCESSORS = 4;

MODEL:
    %OVERALL%
    i s | y1@0 y2@1 y3@2 y4@3;
    i s ON x1 x2;

OUTPUT:
    SAMPSTAT STANDARDIZED TECH1 TECH8 TECH11 TECH14;

! GMM 局部极大风险高, STARTS 建议不少于 500 100;
! 最优对数似然须在多个起点数下可复现(BEST LOGLIKELIHOOD NOT REPLICATED 警告)。
