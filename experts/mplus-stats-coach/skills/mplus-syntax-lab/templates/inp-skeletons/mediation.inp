TITLE:
    Mediation skeleton - indirect effect via MODEL INDIRECT (self-authored)

DATA:
    FILE IS mydata.dat;

VARIABLE:
    NAMES ARE x m y1-y3 c1-c2;
    USEVARIABLES = x m y1-y3 c1-c2;
    MISSING = ALL (-999);

ANALYSIS:
    ESTIMATOR = ML;
    BOOTSTRAP = 5000;

MODEL:
    y BY y1-y3;
    y ON m x c1 c2;
    m ON x c1 c2;

MODEL INDIRECT:
    y IND m x;

OUTPUT:
    SAMPSTAT STANDARDIZED CINTERVAL(BCBOOTSTRAP);
