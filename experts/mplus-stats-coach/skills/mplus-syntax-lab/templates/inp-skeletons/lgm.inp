TITLE:
    LGM skeleton - linear latent growth model, four waves (self-authored)

DATA:
    FILE IS mydata.dat;

VARIABLE:
    NAMES ARE id y1-y4 x1 x2;
    USEVARIABLES = y1-y4 x1 x2;
    MISSING = ALL (-999);

ANALYSIS:
    ESTIMATOR = MLR;

MODEL:
    i s | y1@0 y2@1 y3@2 y4@3;
    i s ON x1 x2;
    [i s];

OUTPUT:
    SAMPSTAT STANDARDIZED TECH1 TECH4;
